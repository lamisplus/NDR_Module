th":"54","messages":"55","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":"56"},{"filePath":"57","messages":"58","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":"59"},{"filePath":"60","messages":"61","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":"62"},{"filePath":"63","messages":"64","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"65","messages":"66","errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":1,"source":"67"},{"filePath":"68","messages":"69","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":"70"},{"filePath":"71","messages":"72","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":1,"source":"73"},{"filePath":"74","messages":"75","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"76","messages":"77","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":"78"},{"filePath":"79","messages":"80","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\index.js",["81"],"import React from \"react\";\r\nimport ReactDOM from \"react-dom\";\r\nimport App from \"./App\";\r\nimport { BrowserRouter, MemoryRouter as Router,} from 'react-router-dom';\r\n\r\nimport reportWebVitals from \"./../src/main/webapp/reportWebVitals\";\r\nimport SimpleReactLightbox from \"simple-react-lightbox\";\r\nimport  ThemeContext  from \"./../src/main/webapp/context/ThemeContext\"; \r\n\r\nReactDOM.render(\r\n\t<React.StrictMode>\r\n\r\n            <SimpleReactLightbox>\r\n                <BrowserRouter basename='/'>\r\n                    <ThemeContext>\r\n                        <App />\r\n                    </ThemeContext>  \r\n                </BrowserRouter>\r\n            </SimpleReactLightbox>\r\n\r\n\t</React.StrictMode>,\r\n  document.getElementById(\"root\")\r\n);\r\nreportWebVitals();\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\App.js",["82"],"import React from \"react\";\r\nimport { MemoryRouter as Router, Switch, Route } from \"react-router-dom\";\r\n\r\nimport { ToastContainer } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport \"./main/webapp/vendor/bootstrap-select/dist/css/bootstrap-select.min.css\";\r\nimport \"./../src/main/webapp/css/style.css\";\r\nimport \"bootstrap/dist/css/bootstrap.css\";\r\nimport HomePage from \"./main/webapp/jsx/components/ndr/Dashboard\";\r\nimport Errors from \"./main/webapp/jsx/components/ndr/Errors\";\r\n//import HomePage from './main/webapp/jsx/ndr/Dashboard'\r\n\r\nexport default function App() {\r\n  return (\r\n    <Router>\r\n      <div>\r\n        <ToastContainer />\r\n        {/* A <Switch> looks through its children <Route>s and\r\n            renders the first one that matches the current URL. */}\r\n        <Switch>\r\n          <Route path=\"/\">\r\n            <HomePage />\r\n          </Route>\r\n        </Switch>\r\n      </div>\r\n    </Router>\r\n  );\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\reportWebVitals.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\context\\ThemeContext.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\context\\ThemeDemo.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Errors.js",["83","84","85","86","87"],"import React, { forwardRef, useState } from \"react\";\r\nimport { Row, Col, CardBody, Card } from \"reactstrap\";\r\nimport MaterialTable from \"material-table\";\r\nimport AddBox from \"@material-ui/icons/AddBox\";\r\nimport ArrowUpward from \"@material-ui/icons/ArrowUpward\";\r\nimport Check from \"@material-ui/icons/Check\";\r\nimport ChevronLeft from \"@material-ui/icons/ChevronLeft\";\r\nimport ChevronRight from \"@material-ui/icons/ChevronRight\";\r\nimport Clear from \"@material-ui/icons/Clear\";\r\nimport DeleteOutline from \"@material-ui/icons/DeleteOutline\";\r\nimport Edit from \"@material-ui/icons/Edit\";\r\nimport FilterList from \"@material-ui/icons/FilterList\";\r\nimport FirstPage from \"@material-ui/icons/FirstPage\";\r\nimport LastPage from \"@material-ui/icons/LastPage\";\r\nimport Remove from \"@material-ui/icons/Remove\";\r\nimport SaveAlt from \"@material-ui/icons/SaveAlt\";\r\nimport Search from \"@material-ui/icons/Search\";\r\nimport ViewColumn from \"@material-ui/icons/ViewColumn\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport moment from \"moment\";\r\n\r\nconst tableIcons = {\r\n  Add: forwardRef((props, ref) => <AddBox {...props} ref={ref} />),\r\n  Check: forwardRef((props, ref) => <Check {...props} ref={ref} />),\r\n  Clear: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref} />),\r\n  DetailPanel: forwardRef((props, ref) => (\r\n    <ChevronRight {...props} ref={ref} />\r\n  )),\r\n  Edit: forwardRef((props, ref) => <Edit {...props} ref={ref} />),\r\n  Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref} />),\r\n  Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref} />),\r\n  FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref} />),\r\n  LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref} />),\r\n  NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref} />),\r\n  PreviousPage: forwardRef((props, ref) => (\r\n    <ChevronLeft {...props} ref={ref} />\r\n  )),\r\n  ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Search: forwardRef((props, ref) => <Search {...props} ref={ref} />),\r\n  SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref} />),\r\n  ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref} />),\r\n  ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref} />),\r\n};\r\n\r\nconst ErrorPage = (props) => {\r\n  const [loading, setLoading] = useState(\"\");\r\n  return (\r\n    <div>\r\n      <Card>\r\n        <CardBody>\r\n          <MaterialTable\r\n            icons={tableIcons}\r\n            title=\"NDR XML errors generated\"\r\n            columns={[\r\n              { title: \"Hospital No\", field: \"hospital_no\", filtering: false },\r\n              {\r\n                title: \"Patient Id\",\r\n                field: \"patient_id\",\r\n                filtering: false,\r\n              },\r\n              {\r\n                title: \"Error Message\",\r\n                field: \"error_message\",\r\n                filtering: false,\r\n              },\r\n            ]}\r\n            isLoading={loading}\r\n            data={props.errors.map((row) => ({\r\n              hospital_no: row.hospitalNumber,\r\n              patient_id: row.patientUuid,\r\n              error_message: row.errorMessage,\r\n            }))}\r\n            options={{\r\n              pageSizeOptions: [10, 50, 100, 150, 500],\r\n              headerStyle: {\r\n                backgroundColor: \"#014d88\",\r\n                color: \"#fff\",\r\n                margin: \"auto\",\r\n              },\r\n              filtering: true,\r\n              searchFieldStyle: {\r\n                width: \"300%\",\r\n                margingLeft: \"250px\",\r\n              },\r\n              exportButton: false,\r\n              searchFieldAlignment: \"left\",\r\n              pageSize: 10,\r\n            }}\r\n          />\r\n        </CardBody>\r\n      </Card>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default ErrorPage;\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Dashboard.js",["88"],"import React, { useState, useEffect } from \"react\";\r\nimport PropTypes from \"prop-types\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport AppBar from \"@material-ui/core/AppBar\";\r\nimport Tabs from \"@material-ui/core/Tabs\";\r\nimport Tab from \"@material-ui/core/Tab\";\r\nimport Typography from \"@material-ui/core/Typography\";\r\nimport Box from \"@material-ui/core/Box\";\r\nimport Paper from \"@material-ui/core/Paper\";\r\nimport Breadcrumbs from \"@material-ui/core/Breadcrumbs\";\r\nimport Link from \"@material-ui/core/Link\";\r\nimport { MdDashboard, MdContacts } from \"react-icons/md\";\r\nimport ErrorIcon from \"@mui/icons-material/Error\";\r\nimport CloudDownloadIcon from \"@mui/icons-material/CloudDownload\";\r\nimport SettingsIcon from \"@mui/icons-material/Settings\";\r\nimport VisibilityOffIcon from \"@mui/icons-material/VisibilityOff\";\r\nimport FingerprintIcon from \"@mui/icons-material/Fingerprint\";\r\nimport HomeIcon from \"@mui/icons-material/Home\";\r\nimport NavigateNextIcon from \"@mui/icons-material/NavigateNext\";\r\nimport GenerateNdr from \"./generate\";\r\nimport HTS from \"./hts\";\r\nimport Prep from \"./Prep\";\r\nimport DownloadNdr from \"./download\";\r\nimport Biometrics from \"./Biometrics\";\r\nimport ErrorPage from \"./Errors\";\r\nimport NdrConfiguration from \"./NdrConfiguration\";\r\nimport Redact from \"./Redact\";\r\nimport { getQueryParams } from \"./../PageUtils\";\r\n\r\nfunction TabPanel(props) {\r\n  const { children, value, index, ...other } = props;\r\n\r\n  return (\r\n    <div\r\n      role=\"tabpanel\"\r\n      hidden={value !== index}\r\n      id={`scrollable-force-tabpanel-${index}`}\r\n      aria-labelledby={`scrollable-force-tab-${index}`}\r\n      {...other}\r\n    >\r\n      {value === index && <Box p={3}>{children}</Box>}\r\n    </div>\r\n  );\r\n}\r\n\r\nTabPanel.propTypes = {\r\n  children: PropTypes.node,\r\n  index: PropTypes.any.isRequired,\r\n  value: PropTypes.any.isRequired,\r\n};\r\n\r\nfunction a11yProps(index) {\r\n  return {\r\n    id: `scrollable-force-tab-${index}`,\r\n    \"aria-controls\": `scrollable-force-tabpanel-${index}`,\r\n  };\r\n}\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    flexGrow: 1,\r\n    width: \"100%\",\r\n    backgroundColor: \"#f5f7fa\",\r\n    minHeight: \"100vh\",\r\n  },\r\n  breadcrumbBar: {\r\n    backgroundColor: \"#fff\",\r\n    padding: theme.spacing(1.5, 3),\r\n    borderBottom: \"1px solid #e0e0e0\",\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    justifyContent: \"space-between\",\r\n  },\r\n  breadcrumbTitle: {\r\n    fontSize: \"1.25rem\",\r\n    fontWeight: 600,\r\n    color: \"#014d88\",\r\n    margin: 0,\r\n  },\r\n  breadcrumbLink: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    color: \"#5c6bc0\",\r\n    textDecoration: \"none\",\r\n    fontSize: \"0.85rem\",\r\n    \"&:hover\": {\r\n      textDecoration: \"underline\",\r\n      color: \"#014d88\",\r\n    },\r\n  },\r\n  appBar: {\r\n    backgroundColor: \"#fff\",\r\n    boxShadow: \"0 1px 4px rgba(0,0,0,0.08)\",\r\n    borderBottom: \"1px solid #e8eaf6\",\r\n  },\r\n  tabs: {\r\n    \"& .MuiTabs-indicator\": {\r\n      backgroundColor: \"#014d88\",\r\n      height: 3,\r\n      borderRadius: \"3px 3px 0 0\",\r\n    },\r\n    \"& .MuiTab-root\": {\r\n      textTransform: \"none\",\r\n      fontWeight: 500,\r\n      fontSize: \"0.82rem\",\r\n      minWidth: 120,\r\n      color: \"#5f6368\",\r\n      transition: \"all 0.2s ease\",\r\n      padding: theme.spacing(1.5, 2),\r\n      \"&:hover\": {\r\n        backgroundColor: \"#f0f2ff\",\r\n        color: \"#014d88\",\r\n      },\r\n    },\r\n    \"& .Mui-selected\": {\r\n      color: \"#014d88 !important\",\r\n      fontWeight: 600,\r\n    },\r\n  },\r\n  tabIcon: {\r\n    fontSize: \"1.25rem\",\r\n    marginBottom: theme.spacing(0.5),\r\n  },\r\n  contentArea: {\r\n    padding: theme.spacing(2, 3),\r\n    backgroundColor: \"#f5f7fa\",\r\n    minHeight: \"calc(100vh - 180px)\",\r\n  },\r\n  tabContentWrapper: {\r\n    backgroundColor: \"#fff\",\r\n    borderRadius: 8,\r\n    boxShadow: \"0 1px 3px rgba(0,0,0,0.06)\",\r\n    overflow: \"hidden\",\r\n  },\r\n}));\r\n\r\nconst tabsConfig = [\r\n  { label: \"Treatment XML\", icon: <MdDashboard />, component: GenerateNdr },\r\n  { label: \"HTS XML\", icon: <MdContacts />, component: HTS },\r\n  { label: \"PrEP XML\", icon: <MdContacts />, component: Prep },\r\n  {\r\n    label: \"Biometrics Recapture\",\r\n    icon: <FingerprintIcon />,\r\n    component: Biometrics,\r\n  },\r\n  {\r\n    label: \"Download Files\",\r\n    icon: <CloudDownloadIcon />,\r\n    component: DownloadNdr,\r\n  },\r\n  { label: \"NDR File Errors\", icon: <ErrorIcon />, component: ErrorPage },\r\n  {\r\n    label: \"NDR Configuration\",\r\n    icon: <SettingsIcon />,\r\n    component: NdrConfiguration,\r\n  },\r\n  { label: \"NDR Redacted\", icon: <VisibilityOffIcon />, component: Redact },\r\n];\r\n\r\nconst HomePage = (props) => {\r\n  const classes = useStyles();\r\n  const urlIndex = getQueryParams(\"tab\", props.location);\r\n  const initialTab =\r\n    urlIndex !== null && !isNaN(Number(urlIndex)) ? Number(urlIndex) : 0;\r\n  const [value, setValue] = useState(initialTab);\r\n  const [errors, setErrors] = useState([]);\r\n\r\n  useEffect(() => {\r\n    if (\r\n      urlIndex !== null &&\r\n      !isNaN(Number(urlIndex)) &&\r\n      Number(urlIndex) !== value\r\n    ) {\r\n      setValue(Number(urlIndex));\r\n    }\r\n  }, [urlIndex]);\r\n\r\n  const handleChange = (event, newValue) => {\r\n    setValue(newValue);\r\n  };\r\n\r\n  return (\r\n    <div className={classes.root}>\r\n      <div className={classes.breadcrumbBar}>\r\n        <div>\r\n          <Breadcrumbs\r\n            separator={\r\n              <NavigateNextIcon fontSize=\"small\" style={{ color: \"#9e9e9e\" }} />\r\n            }\r\n            aria-label=\"breadcrumb\"\r\n          >\r\n            <Link className={classes.breadcrumbLink} href=\"/\">\r\n              <HomeIcon style={{ fontSize: 16, marginRight: 4 }} />\r\n              Home\r\n            </Link>\r\n            <Typography style={{ fontSize: \"0.85rem\", color: \"#757575\" }}>\r\n              NDR\r\n            </Typography>\r\n          </Breadcrumbs>\r\n          <h4 className={classes.breadcrumbTitle}>\r\n            LAMISPlus NDR Data Exchange Management\r\n          </h4>\r\n        </div>\r\n        <Typography variant=\"caption\" style={{ color: \"#9e9e9e\" }}>\r\n          National Data Repository\r\n        </Typography>\r\n      </div>\r\n\r\n      {/* Tabs */}\r\n      <AppBar position=\"static\" className={classes.appBar} elevation={0}>\r\n        <Tabs\r\n          value={value}\r\n          onChange={handleChange}\r\n          variant=\"scrollable\"\r\n          scrollButtons=\"auto\"\r\n          indicatorColor=\"primary\"\r\n          textColor=\"primary\"\r\n          aria-label=\"NDR navigation tabs\"\r\n          className={classes.tabs}\r\n        >\r\n          {tabsConfig.map((tab, index) => (\r\n            <Tab\r\n              key={index}\r\n              label={tab.label}\r\n              icon={tab.icon}\r\n              {...a11yProps(index)}\r\n            />\r\n          ))}\r\n        </Tabs>\r\n      </AppBar>\r\n\r\n      {/* Content */}\r\n      <div className={classes.contentArea}>\r\n        <Paper className={classes.tabContentWrapper} elevation={0}>\r\n          {tabsConfig.map((tab, index) => {\r\n            const Component = tab.component;\r\n            if (index === 4) {\r\n              return (\r\n                <TabPanel\r\n                  key={index}\r\n                  value={value}\r\n                  setValue={setValue}\r\n                  index={index}\r\n                >\r\n                  <Component\r\n                    value={value}\r\n                    setValue={setValue}\r\n                    setErrors={setErrors}\r\n                  />\r\n                </TabPanel>\r\n              );\r\n            }\r\n            if (index === 5) {\r\n              return (\r\n                <TabPanel\r\n                  key={index}\r\n                  value={value}\r\n                  setValue={setValue}\r\n                  index={index}\r\n                >\r\n                  <Component\r\n                    value={value}\r\n                    setValue={setValue}\r\n                    errors={errors}\r\n                  />\r\n                </TabPanel>\r\n              );\r\n            }\r\n            return (\r\n              <TabPanel\r\n                key={index}\r\n                value={value}\r\n                setValue={setValue}\r\n                index={index}\r\n              >\r\n                <Component value={value} setValue={setValue} />\r\n              </TabPanel>\r\n            );\r\n          })}\r\n        </Paper>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default HomePage;\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\hts.js",["89","90"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useCallback,\r\n  useMemo,\r\n} from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport axios from \"axios\";\r\nimport * as api from \"./../../../api\";\r\nimport { token as token, url as baseUrl } from \"./../../../api\";\r\nimport { CardBody, Card } from \"reactstrap\";\r\nimport { Alert, AlertTitle } from \"@material-ui/lab\";\r\nimport { GiFiles } from \"react-icons/gi\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport MaterialTable, { MTableToolbar } from \"material-table\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport \"react-widgets/dist/css/react-widgets.css\";\r\nimport { Modal, ModalBody } from \"reactstrap\";\r\nimport {\r\n  AddBox,\r\n  ArrowUpward,\r\n  Check,\r\n  ChevronLeft,\r\n  ChevronRight,\r\n  Clear,\r\n  DeleteOutline,\r\n  Edit,\r\n  FilterList,\r\n  FirstPage,\r\n  LastPage,\r\n  Remove,\r\n  SaveAlt,\r\n  Search,\r\n  ViewColumn,\r\n} from \"@material-ui/icons\";\r\nimport uniq from \"lodash/uniq\";\r\n\r\nconst tableIcons = {\r\n  Add: forwardRef((props, ref) => <AddBox {...props} ref={ref} />),\r\n  Check: forwardRef((props, ref) => <Check {...props} ref={ref} />),\r\n  Clear: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref} />),\r\n  DetailPanel: forwardRef((props, ref) => (\r\n    <ChevronRight {...props} ref={ref} />\r\n  )),\r\n  Edit: forwardRef((props, ref) => <Edit {...props} ref={ref} />),\r\n  Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref} />),\r\n  Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref} />),\r\n  FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref} />),\r\n  LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref} />),\r\n  NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref} />),\r\n  PreviousPage: forwardRef((props, ref) => (\r\n    <ChevronLeft {...props} ref={ref} />\r\n  )),\r\n  ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Search: forwardRef((props, ref) => <Search {...props} ref={ref} />),\r\n  SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref} />),\r\n  ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref} />),\r\n  ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref} />),\r\n};\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    width: \"100%\",\r\n  },\r\n  card: {\r\n    border: \"none\",\r\n    borderRadius: 10,\r\n    boxShadow: \"0 2px 12px rgba(0,0,0,0.06)\",\r\n  },\r\n  sectionTitle: {\r\n    fontSize: \"0.95rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1),\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n  },\r\n  radioGroup: {\r\n    display: \"flex\",\r\n    gap: theme.spacing(3),\r\n    padding: theme.spacing(1.5, 2),\r\n    backgroundColor: \"#f8f9ff\",\r\n    borderRadius: 8,\r\n    border: \"1px solid #e8eaf6\",\r\n  },\r\n  radioLabel: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 8,\r\n    cursor: \"pointer\",\r\n    fontSize: \"0.875rem\",\r\n    fontWeight: 500,\r\n    color: \"#333\",\r\n    margin: 0,\r\n  },\r\n  facilityPanel: {\r\n    backgroundColor: \"#fff\",\r\n    border: \"1px solid #e8eaf6\",\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1),\r\n    maxHeight: 280,\r\n    overflowY: \"auto\",\r\n  },\r\n  facilityItem: {\r\n    borderRadius: 6,\r\n    marginBottom: 4,\r\n    \"&:hover\": {\r\n      backgroundColor: \"#f0f2ff\",\r\n    },\r\n  },\r\n  facilityIcon: {\r\n    minWidth: 36,\r\n    color: \"#5c6bc0\",\r\n  },\r\n  generateBtn: {\r\n    backgroundColor: \"#014d88\",\r\n    color: \"#fff\",\r\n    textTransform: \"none\",\r\n    fontWeight: 600,\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1.2, 3),\r\n    boxShadow: \"0 2px 8px rgba(1,77,136,0.25)\",\r\n    \"&:hover\": {\r\n      backgroundColor: \"#013a66\",\r\n      boxShadow: \"0 4px 12px rgba(1,77,136,0.35)\",\r\n    },\r\n    \"&:disabled\": {\r\n      backgroundColor: \"#b0bec5\",\r\n      color: \"#fff\",\r\n    },\r\n  },\r\n  emptyState: {\r\n    padding: theme.spacing(4),\r\n    textAlign: \"center\",\r\n    color: \"#9e9e9e\",\r\n    fontSize: \"0.85rem\",\r\n  },\r\n  modalBody: {\r\n    padding: theme.spacing(4),\r\n    textAlign: \"center\",\r\n  },\r\n  modalTitle: {\r\n    fontSize: \"1.1rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(2),\r\n  },\r\n  spinner: {\r\n    width: 40,\r\n    height: 40,\r\n    margin: \"0 auto 16px\",\r\n    border: \"4px solid #e3f2fd\",\r\n    borderTop: \"4px solid #014d88\",\r\n    borderRadius: \"50%\",\r\n    animation: \"$spin 1s linear infinite\",\r\n  },\r\n  \"@keyframes spin\": {\r\n    \"0%\": { transform: \"rotate(0deg)\" },\r\n    \"100%\": { transform: \"rotate(360deg)\" },\r\n  },\r\n  errorAlert: {\r\n    marginTop: theme.spacing(2),\r\n  },\r\n}));\r\n\r\nexport default function Prep(props) {\r\n  const classes = useStyles();\r\n  const [facilities, setFacilities] = useState([]);\r\n  const [processing, setProcessing] = useState(false);\r\n  const [status, setStatus] = useState(false); // false = Updated, true = Initial\r\n  const [checked, setChecked] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedRows, setSelectedRows] = useState([]);\r\n  const [selectPatients, setSelectPatients] = useState([]);\r\n\r\n  const toggle = useCallback(() => setModal((m) => !m), []);\r\n\r\n  useEffect(() => {\r\n    let isMounted = true;\r\n    axios\r\n      .get(`${api.url}account`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        if (!isMounted) return;\r\n        setFacilities(response.data.applicationUserOrganisationUnits || []);\r\n      })\r\n      .catch(() => {\r\n        toast.error(\"Unable to load facilities. Please refresh the page.\");\r\n      });\r\n    return () => {\r\n      isMounted = false;\r\n    };\r\n  }, []);\r\n\r\n  const handleToggle = useCallback(\r\n    (value) => () => {\r\n      setChecked((prev) => {\r\n        const currentIndex = prev.indexOf(value);\r\n        const newChecked = [...prev];\r\n        if (currentIndex === -1) newChecked.push(value);\r\n        else newChecked.splice(currentIndex, 1);\r\n        return newChecked;\r\n      });\r\n    },\r\n    [],\r\n  );\r\n\r\n  const handleRowSelection = useCallback((rows) => {\r\n    setSelectedRows(rows);\r\n    setSelectPatients(uniq(rows).map((row) => row.uuid));\r\n  }, []);\r\n\r\n  const facilityQueryString = useMemo(() => {\r\n    return checked\r\n      .map((value) => `facilityIds=${value.organisationUnitId}`)\r\n      .join(\"&\");\r\n  }, [checked]);\r\n\r\n  const generateAction = useCallback(async () => {\r\n    if (!facilityQueryString) return;\r\n\r\n    setProcessing(true);\r\n    setModal(true);\r\n\r\n    const usePatients = selectPatients.length > 0;\r\n    const url = usePatients\r\n      ? `${api.url}ndr/generate/hts?${facilityQueryString}&isInitial=${status}&patientIds=${selectPatients}`\r\n      : `${api.url}ndr/hts?${facilityQueryString}&isInitial=${status}`;\r\n\r\n    try {\r\n      await axios.get(url, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      });\r\n\r\n      window.setTimeout(() => {\r\n        toast.success(\"Generating HTS XML Successful!\");\r\n        setModal(false);\r\n        setProcessing(false);\r\n        setSelectPatients([]);\r\n        props.setValue(4);\r\n      }, 3000);\r\n    } catch (error) {\r\n      setModal(false);\r\n      setProcessing(false);\r\n\r\n      const errorMessage =\r\n        error?.response?.data?.apierror?.message?.trim() ||\r\n        \"Something went wrong. Please try again.\";\r\n\r\n      toast.error(errorMessage);\r\n    }\r\n  }, [facilityQueryString, selectPatients, status, props]);\r\n\r\n  const hasFacilities = facilities.length > 0;\r\n  const canGenerate = checked.length >= 1 && !processing;\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n\r\n      <Card className={classes.card}>\r\n        <CardBody>\r\n          {/* Info alert */}\r\n          <Alert severity=\"info\">\r\n            <AlertTitle>Generate HTS XML</AlertTitle>\r\n            Select one or more facilities below, choose the data type, then\r\n            click\r\n            <strong> Generate HTS XML</strong>. You may optionally select\r\n            specific patients from the table to limit the export.\r\n          </Alert>\r\n\r\n          <div className=\"row mt-4\">\r\n            {/* Data Type */}\r\n            <div className=\"col-md-4\">\r\n              <div className={classes.sectionTitle}>Data Type</div>\r\n              <div className={classes.radioGroup}>\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === false}\r\n                    onChange={() => setStatus(false)}\r\n                  />\r\n                  Updated\r\n                </label>\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === true}\r\n                    onChange={() => setStatus(true)}\r\n                  />\r\n                  Initial\r\n                </label>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Facilities */}\r\n            <div className=\"col-md-4\">\r\n              <div className={classes.sectionTitle}>\r\n                <AccountBalanceIcon style={{ fontSize: 16 }} />\r\n                Facilities ({checked.length} selected)\r\n              </div>\r\n              <div className={classes.facilityPanel}>\r\n                {hasFacilities ? (\r\n                  facilities.map((value) => {\r\n                    const labelId = `facility-${value.id}`;\r\n                    return (\r\n                      <div\r\n                        key={value.id}\r\n                        className={classes.facilityItem}\r\n                        onClick={handleToggle(value)}\r\n                        role=\"button\"\r\n                        tabIndex={0}\r\n                        onKeyDown={(e) =>\r\n                          e.key === \"Enter\" && handleToggle(value)()\r\n                        }\r\n                        style={{\r\n                          display: \"flex\",\r\n                          alignItems: \"center\",\r\n                          padding: \"6px 10px\",\r\n                          cursor: \"pointer\",\r\n                        }}\r\n                      >\r\n                        <input\r\n                          type=\"checkbox\"\r\n                          checked={checked.indexOf(value) !== -1}\r\n                          onChange={handleToggle(value)}\r\n                          onClick={(e) => e.stopPropagation()}\r\n                          style={{ marginRight: 10, cursor: \"pointer\" }}\r\n                        />\r\n                        <span style={{ fontSize: \"0.85rem\", color: \"#333\" }}>\r\n                          {value.organisationUnitName}\r\n                        </span>\r\n                      </div>\r\n                    );\r\n                  })\r\n                ) : (\r\n                  <div className={classes.emptyState}>\r\n                    No facilities available\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n\r\n            {/* Action */}\r\n            <div className=\"col-md-4 d-flex flex-column justify-content-between\">\r\n              <div className={classes.sectionTitle}>Action</div>\r\n              <Button\r\n                variant=\"contained\"\r\n                className={classes.generateBtn}\r\n                disabled={!canGenerate}\r\n                onClick={generateAction}\r\n                startIcon={<GiFiles />}\r\n              >\r\n                {processing ? \"Generating...\" : \"Generate HTS XML\"}\r\n              </Button>\r\n              {selectPatients.length > 0 && (\r\n                <div\r\n                  style={{\r\n                    fontSize: \"0.78rem\",\r\n                    color: \"#5c6bc0\",\r\n                    marginTop: 8,\r\n                  }}\r\n                >\r\n                  {selectPatients.length} patient(s) selected for export\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"mt-4\">\r\n            <MaterialTable\r\n              icons={tableIcons}\r\n              title=\"Eligible Patients\"\r\n              columns={[\r\n                { title: \"Client Code\", field: \"uuid\", filtering: false },\r\n                { title: \"HTS Count\", field: \"status\", filtering: false },\r\n              ]}\r\n              data={(query) =>\r\n                new Promise((resolve, reject) =>\r\n                  axios\r\n                    .get(\r\n                      `${baseUrl}hts-encounter/hts-patients?search=${query.search}&page=${query.page}&size=${query.pageSize}`,\r\n                      { headers: { Authorization: `Bearer ${token}` } },\r\n                    )\r\n                    .then((response) => response)\r\n                    .then((result) => {\r\n                      resolve({\r\n                        data: result.data.records.map((row) => ({\r\n                          uuid: row.clientCode,\r\n                          status: row.htsCount,\r\n                        })),\r\n                        page: query.page,\r\n                        totalCount: result.data.totalRecords,\r\n                      });\r\n                    })\r\n                    .catch(() => {\r\n                      resolve({ data: [], page: 0, totalCount: 0 });\r\n                      toast.error(\"Failed to load patients.\");\r\n                    })\r\n                    .finally(() => setSelectedRows([])),\r\n                )\r\n              }\r\n              options={{\r\n                search: true,\r\n                selection: true,\r\n                headerStyle: {\r\n                  backgroundColor: \"#014d88\",\r\n                  color: \"#fff\",\r\n                  fontWeight: 600,\r\n                },\r\n                rowStyle: (rowData) => ({\r\n                  backgroundColor: selectedRows.find(\r\n                    (row) => row.tableData.id === rowData.tableData.id,\r\n                  )\r\n                    ? \"#e8f5e9\"\r\n                    : \"\",\r\n                }),\r\n                filtering: false,\r\n                exportButton: false,\r\n                searchFieldAlignment: \"left\",\r\n                pageSizeOptions: [10, 20, 100],\r\n                pageSize: 10,\r\n                debounceInterval: 400,\r\n                toolbar: true,\r\n              }}\r\n              components={{\r\n                Toolbar: (toolbarProps) => (\r\n                  <div>\r\n                    <MTableToolbar {...toolbarProps} />\r\n                  </div>\r\n                ),\r\n              }}\r\n              onSelectionChange={handleRowSelection}\r\n            />\r\n          </div>\r\n        </CardBody>\r\n      </Card>\r\n\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={toggle}\r\n        backdrop=\"static\"\r\n        centered\r\n        size=\"md\"\r\n      >\r\n        <ModalBody className={classes.modalBody}>\r\n          <div className={classes.spinner} />\r\n          <div className={classes.modalTitle}>Generating HTS XML Files</div>\r\n          <div style={{ color: \"#666\", fontSize: \"0.85rem\" }}>\r\n            Please wait while we process your request. This may take a few\r\n            moments.\r\n          </div>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Redact.js",["91","92","93","94"],"import React, { useState, useEffect } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport List from \"@material-ui/core/List\";\r\nimport ListItem from \"@material-ui/core/ListItem\";\r\nimport ListItemSecondaryAction from \"@material-ui/core/ListItemSecondaryAction\";\r\nimport ListItemText from \"@material-ui/core/ListItemText\";\r\nimport ListItemAvatar from \"@material-ui/core/ListItemAvatar\";\r\nimport Checkbox from \"@material-ui/core/Checkbox\";\r\nimport axios from \"axios\";\r\nimport * as api from \"./../../../api\";\r\nimport { token as token, url as baseUrl } from \"./../../../api\";\r\nimport { CardBody, Card } from \"reactstrap\";\r\nimport { Alert, AlertTitle } from \"@material-ui/lab\";\r\nimport { GiFiles } from \"react-icons/gi\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport { Modal, ModalBody } from \"reactstrap\";\r\n//import { useHistory } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport \"react-widgets/dist/css/react-widgets.css\";\r\n//import { Spinner } from \"reactstrap\";\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    width: \"100%\",\r\n    maxWidth: 360,\r\n    backgroundColor: theme.palette.background.paper,\r\n    \"& > * + *\": {\r\n      marginTop: theme.spacing(2),\r\n    },\r\n  },\r\n}));\r\n\r\nexport default function Redact(props) {\r\n  //const [loading, stillLoading] = useState(true)\r\n  //let history = useHistory();\r\n  const classes = useStyles();\r\n  const [facilities, setFacilities] = useState([]);\r\n  const [processing, setProcessing] = useState(false);\r\n  const [facilitiesApi, setfacilitiesApi] = useState({ facilities: [] });\r\n  const [status, setStatus] = useState(false);\r\n  const [checked, setChecked] = React.useState([]);\r\n  const [user, setUser] = useState(null);\r\n  const [modal, setModal] = useState(false);\r\n  const toggle = () => setModal(!modal);\r\n\r\n  useEffect(() => {\r\n    fetchMe();\r\n  }, []);\r\n\r\n  ///GET LIST OF FACILITIES\r\n  async function fetchMe() {\r\n    axios\r\n      .get(`${api.url}account`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        setUser(response.data);\r\n        setFacilities(response.data.applicationUserOrganisationUnits);\r\n      })\r\n      .catch((error) => {});\r\n  }\r\n\r\n  //GET LIST OF NDR GENERATED\r\n  const handleToggle = (value) => () => {\r\n    const currentIndex = checked.indexOf(value);\r\n    const newChecked = [...checked];\r\n\r\n    if (currentIndex === -1) {\r\n      newChecked.push(value);\r\n    } else {\r\n      newChecked.splice(currentIndex, 1);\r\n    }\r\n\r\n    setChecked(newChecked);\r\n  };\r\n\r\n  const handleChange = (event) => {\r\n    setStatus(!status);\r\n  };\r\n  const generateAction = () => {\r\n    setProcessing(true);\r\n    setModal(true);\r\n    let FacilityIDArray = \"\";\r\n    //LOOPING THROUGH THE FACILITIES OBJECT ARRAY TO FORM THE NEW OBJECT\r\n    checked.forEach(function (value) {\r\n      const id = value.organisationUnitId;\r\n      const facilityparam = \"facilityIds=\" + id;\r\n      FacilityIDArray = facilityparam;\r\n      //FacilityIDArray.push(id);\r\n    });\r\n    //console.log(FacilityIDArray)\r\n    facilitiesApi[\"facilities\"] = FacilityIDArray;\r\n    //SENDING A POST REQUEST\r\n    axios\r\n      .get(\r\n        `${api.url}ndr/redacted?${FacilityIDArray}&isInitial=${status}`,\r\n        { headers: { Authorization: `Bearer ${token}` } }\r\n      )\r\n      .then((response) => {\r\n        window.setTimeout(() => {\r\n          toast.success(\" Generating Redacted files Successfully!\");\r\n          setModal(false);\r\n          props.setValue(3);\r\n        }, 5000);\r\n\r\n        //props.history.push(\"/generate\", { state: 'download'});\r\n      })\r\n      .catch((error) => {\r\n        setModal(false);\r\n        setProcessing(false); // set the generate button true\r\n        toast.error(\" Something went wrong! Please contact administrator.\");\r\n        if (error.response && error.response.data) {\r\n          let errorMessage =\r\n            error.response.data.apierror &&\r\n            error.response.data.apierror.message !== \"\"\r\n              ? error.response.data.apierror.message\r\n              : \"Something went wrong, please try again\";\r\n          toast.error(errorMessage);\r\n        } else {\r\n          toast.error(\"Something went wrong. Please try again...\");\r\n        }\r\n      });\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n      <Card>\r\n        <CardBody>\r\n          {checked.length >= 1 ? (\r\n            <>\r\n              <Button\r\n                color=\"primary\"\r\n                variant=\"contained\"\r\n                className=\" float-right mr-1\"\r\n                size=\"large\"\r\n                hidden={processing}\r\n                onClick={() => generateAction()}\r\n              >\r\n                {<GiFiles />} &nbsp;&nbsp;\r\n                <span style={{ textTransform: \"capitalize\" }}>\r\n                  {\" \"}\r\n                  Generate Messages\r\n                </span>\r\n              </Button>\r\n            </>\r\n          ) : (\r\n            <>\r\n              <Button\r\n                color=\"primary\"\r\n                variant=\"contained\"\r\n                className=\" float-right mr-1\"\r\n                size=\"large\"\r\n                disabled=\"true\"\r\n              >\r\n                {<GiFiles />} &nbsp;&nbsp;\r\n                <span style={{ textTransform: \"capitalize\" }}>\r\n                  {\" \"}\r\n                  Generate Messages{\" \"}\r\n                </span>\r\n              </Button>\r\n            </>\r\n          )}\r\n\r\n          <>\r\n            <br /> <br />\r\n            <Alert severity=\"info\">\r\n              <AlertTitle>Info</AlertTitle>\r\n              Please check the Facilities you want\r\n            </Alert>\r\n            <br />\r\n            <label>\r\n              <input\r\n                type=\"radio\"\r\n                name=\"status\"\r\n                checked={status === false}\r\n                onChange={handleChange}\r\n              />\r\n              <b> Updated</b>\r\n            </label>\r\n            {\"   \"}\r\n            {\"   \"}\r\n            <label>\r\n              <input\r\n                type=\"radio\"\r\n                name=\"status\"\r\n                checked={status === true}\r\n                onChange={handleChange}\r\n              />\r\n              <b> Initial</b>\r\n            </label>\r\n            <br />\r\n            <List dense className={classes.root}>\r\n              <br />\r\n\r\n              {facilities.map((value) => {\r\n                //console.log(value)\r\n                const labelId = `checkbox-list-secondary-label-${value.id}`;\r\n                return (\r\n                  <ListItem key={value.id} button>\r\n                    <ListItemAvatar>\r\n                      <AccountBalanceIcon />\r\n                    </ListItemAvatar>\r\n                    <ListItemText\r\n                      id={labelId}\r\n                      primary={`${value.organisationUnitName}`}\r\n                    />\r\n                    <ListItemSecondaryAction>\r\n                      <Checkbox\r\n                        edge=\"end\"\r\n                        onChange={handleToggle(value)}\r\n                        checked={checked.indexOf(value) !== -1}\r\n                        inputProps={{ \"aria-labelledby\": labelId }}\r\n                      />\r\n                    </ListItemSecondaryAction>\r\n                  </ListItem>\r\n                );\r\n              })}\r\n            </List>\r\n          </>\r\n        </CardBody>\r\n      </Card>\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={toggle}\r\n        backdrop={false}\r\n        fade={true}\r\n        style={{ marginTop: \"250px\" }}\r\n        size=\"lg\"\r\n      >\r\n        <ModalBody>\r\n          <h2>Generating Redacted File. Please wait...</h2>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\generate.js",["95","96"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  useCallback,\r\n  useMemo,\r\n  forwardRef,\r\n} from \"react\";\r\nimport MaterialTable, { MTableToolbar } from \"material-table\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport axios from \"axios\";\r\nimport * as api from \"./../../../api\";\r\nimport { token as token, url as baseUrl } from \"./../../../api\";\r\nimport { CardBody, Card, FormGroup, Label } from \"reactstrap\";\r\nimport { Alert, AlertTitle } from \"@material-ui/lab\";\r\nimport { GiFiles } from \"react-icons/gi\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport CalendarTodayIcon from \"@material-ui/icons/CalendarToday\";\r\nimport InfoOutlinedIcon from \"@material-ui/icons/InfoOutlined\";\r\nimport { Modal, ModalBody } from \"reactstrap\";\r\nimport { Link } from \"react-router-dom\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport \"react-widgets/dist/css/react-widgets.css\";\r\nimport uniq from \"lodash/uniq\";\r\nimport CircularProgress from \"@mui/material/CircularProgress\";\r\nimport {\r\n  AddBox,\r\n  ArrowUpward,\r\n  Check,\r\n  ChevronLeft,\r\n  ChevronRight,\r\n  Clear,\r\n  DeleteOutline,\r\n  Edit,\r\n  FilterList,\r\n  FirstPage,\r\n  LastPage,\r\n  Remove,\r\n  SaveAlt,\r\n  Search,\r\n  ViewColumn,\r\n} from \"@material-ui/icons\";\r\n\r\nconst tableIcons = {\r\n  Add: forwardRef((props, ref) => <AddBox {...props} ref={ref} />),\r\n  Check: forwardRef((props, ref) => <Check {...props} ref={ref} />),\r\n  Clear: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref} />),\r\n  DetailPanel: forwardRef((props, ref) => (\r\n    <ChevronRight {...props} ref={ref} />\r\n  )),\r\n  Edit: forwardRef((props, ref) => <Edit {...props} ref={ref} />),\r\n  Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref} />),\r\n  Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref} />),\r\n  FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref} />),\r\n  LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref} />),\r\n  NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref} />),\r\n  PreviousPage: forwardRef((props, ref) => (\r\n    <ChevronLeft {...props} ref={ref} />\r\n  )),\r\n  ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Search: forwardRef((props, ref) => <Search {...props} ref={ref} />),\r\n  SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref} />),\r\n  ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref} />),\r\n  ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref} />),\r\n};\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  card: {\r\n    border: \"none\",\r\n    borderRadius: 10,\r\n    boxShadow: \"0 2px 12px rgba(0,0,0,0.06)\",\r\n  },\r\n  headerRow: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    justifyContent: \"space-between\",\r\n    flexWrap: \"wrap\",\r\n    gap: theme.spacing(2),\r\n    marginBottom: theme.spacing(3),\r\n  },\r\n  sectionCard: {\r\n    backgroundColor: \"#f8f9ff\",\r\n    border: \"1px solid #e8eaf6\",\r\n    borderRadius: 8,\r\n    padding: theme.spacing(2),\r\n    marginBottom: theme.spacing(2),\r\n  },\r\n  sectionTitle: {\r\n    fontSize: \"0.95rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1.5),\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n  },\r\n  dateInput: {\r\n    width: \"100%\",\r\n    padding: \"10px 12px\",\r\n    border: \"1px solid #d1d5db\",\r\n    borderRadius: 8,\r\n    fontSize: \"0.875rem\",\r\n    color: \"#333\",\r\n    outline: \"none\",\r\n    transition: \"border-color 0.15s ease\",\r\n    \"&:focus\": {\r\n      borderColor: \"#014d88\",\r\n      boxShadow: \"0 0 0 3px rgba(1,77,136,0.1)\",\r\n    },\r\n  },\r\n  radioGroup: {\r\n    display: \"flex\",\r\n    gap: theme.spacing(3),\r\n    padding: theme.spacing(1.5, 2),\r\n    backgroundColor: \"#fff\",\r\n    borderRadius: 8,\r\n    border: \"1px solid #e8eaf6\",\r\n  },\r\n  radioLabel: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 8,\r\n    cursor: \"pointer\",\r\n    fontSize: \"0.875rem\",\r\n    fontWeight: 500,\r\n    color: \"#333\",\r\n    margin: 0,\r\n  },\r\n  facilityItem: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    padding: \"10px 12px\",\r\n    borderRadius: 6,\r\n    cursor: \"pointer\",\r\n    backgroundColor: \"#fff\",\r\n    border: \"1px solid #e8eaf6\",\r\n    transition: \"all 0.15s ease\",\r\n    \"&:hover\": {\r\n      backgroundColor: \"#f0f2ff\",\r\n    },\r\n  },\r\n  facilityIcon: {\r\n    color: \"#5c6bc0\",\r\n    fontSize: \"1.25rem\",\r\n    marginRight: theme.spacing(1.5),\r\n  },\r\n  facilityName: {\r\n    flex: 1,\r\n    fontSize: \"0.875rem\",\r\n    color: \"#333\",\r\n    fontWeight: 500,\r\n  },\r\n  generateBtn: {\r\n    backgroundColor: \"#014d88\",\r\n    color: \"#fff\",\r\n    textTransform: \"none\",\r\n    fontWeight: 600,\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1.2, 3),\r\n    boxShadow: \"0 2px 8px rgba(1,77,136,0.25)\",\r\n    \"&:hover\": {\r\n      backgroundColor: \"#013a66\",\r\n      boxShadow: \"0 4px 12px rgba(1,77,136,0.35)\",\r\n    },\r\n    \"&:disabled\": {\r\n      backgroundColor: \"#b0bec5\",\r\n      color: \"#fff\",\r\n      boxShadow: \"none\",\r\n    },\r\n  },\r\n  modalBody: {\r\n    padding: theme.spacing(5),\r\n    textAlign: \"center\",\r\n  },\r\n  modalTitle: {\r\n    fontSize: \"1.1rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1.5),\r\n  },\r\n  modalSubtext: {\r\n    color: \"#666\",\r\n    fontSize: \"0.85rem\",\r\n  },\r\n  selectedCounter: {\r\n    display: \"inline-flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n    padding: \"4px 12px\",\r\n    backgroundColor: \"#e8eaf6\",\r\n    borderRadius: 20,\r\n    fontSize: \"0.78rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginLeft: theme.spacing(1),\r\n  },\r\n  modeHint: {\r\n    fontSize: \"0.75rem\",\r\n    color: \"#5c6bc0\",\r\n    fontStyle: \"italic\",\r\n    marginTop: theme.spacing(0.5),\r\n  },\r\n}));\r\n\r\nexport default function GenerateNdr(props) {\r\n  const classes = useStyles();\r\n  const [facilities, setFacilities] = useState([]);\r\n  const [processing, setProcessing] = useState(false);\r\n  const [status, setStatus] = useState(false); // false = Updated, true = Initial\r\n  const [checked, setChecked] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [showPPI, setShowPPI] = useState(false);\r\n  const [selectPatients, setSelectPatients] = useState([]);\r\n  const [selectedRows, setSelectedRows] = useState([]);\r\n\r\n  const currentDate = useMemo(() => new Date().toISOString().split(\"T\")[0], []);\r\n\r\n  const [objValues, setObjValues] = useState({\r\n    startDate: \"\",\r\n    endDate: \"\",\r\n  });\r\n\r\n  useEffect(() => {\r\n    let isMounted = true;\r\n    axios\r\n      .get(`${api.url}account`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        if (!isMounted) return;\r\n        const { currentOrganisationUnitName, currentOrganisationUnitId } =\r\n          response.data;\r\n        setFacilities([\r\n          {\r\n            facility: currentOrganisationUnitName,\r\n            facilityId: currentOrganisationUnitId,\r\n          },\r\n        ]);\r\n      })\r\n      .catch(() => {\r\n        toast.error(\"Unable to load facilities. Please refresh the page.\");\r\n      });\r\n    return () => {\r\n      isMounted = false;\r\n    };\r\n  }, []);\r\n\r\n  const handleToggle = useCallback(\r\n    (value) => () => {\r\n      setChecked((prev) => {\r\n        const currentIndex = prev.indexOf(value);\r\n        const newChecked = [...prev];\r\n        if (currentIndex === -1) newChecked.push(value);\r\n        else newChecked.splice(currentIndex, 1);\r\n        return newChecked;\r\n      });\r\n    },\r\n    [],\r\n  );\r\n\r\n  const facilityQueryString = useMemo(() => {\r\n    return checked.map((value) => `facilityIds=${value.facilityId}`).join(\"&\");\r\n  }, [checked]);\r\n\r\n  const handleRowSelection = useCallback((rows) => {\r\n    setSelectedRows(rows);\r\n    setSelectPatients(uniq(rows).map((row) => row.uuid));\r\n  }, []);\r\n\r\n  const handleInputChange = useCallback((e) => {\r\n    const { name, value } = e.target;\r\n    setObjValues((prev) => ({ ...prev, [name]: value }));\r\n  }, []);\r\n\r\n  const clearDateRange = useCallback(() => {\r\n    setObjValues({ startDate: \"\", endDate: \"\" });\r\n  }, []);\r\n\r\n  const generationMode = useMemo(() => {\r\n    if (selectPatients.length > 0) return \"patients\";\r\n    if (objValues.startDate && objValues.endDate) return \"date-range\";\r\n    return \"default\";\r\n  }, [selectPatients, objValues]);\r\n\r\n  const dateRangeInvalid = useMemo(() => {\r\n    if (!objValues.startDate || !objValues.endDate) return false;\r\n    return objValues.startDate > objValues.endDate;\r\n  }, [objValues]);\r\n\r\n  const generateAction = useCallback(async () => {\r\n    if (!facilityQueryString) {\r\n      toast.warn(\"Please select at least one facility.\");\r\n      return;\r\n    }\r\n\r\n    if (dateRangeInvalid) {\r\n      toast.error(\"End date must be after start date.\");\r\n      return;\r\n    }\r\n\r\n    setProcessing(true);\r\n    setModal(true);\r\n    setSelectedRows([]);\r\n\r\n    let url = \"\";\r\n    let redirectTab = 4;\r\n\r\n    if (generationMode === \"patients\") {\r\n      url = `${api.url}ndr/generate/patients?${facilityQueryString}&initial=${status}&patientIds=${selectPatients}`;\r\n    } else if (generationMode === \"date-range\") {\r\n      url = `${api.url}ndr/optimization/date-range?${facilityQueryString}&startDate=${objValues.startDate}&endDate=${objValues.endDate}`;\r\n    } else {\r\n      url = `${api.url}ndr/optimization?${facilityQueryString}&isInitial=${status}`;\r\n      redirectTab = 4;\r\n    }\r\n\r\n    try {\r\n      await axios.get(url, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      });\r\n\r\n      window.setTimeout(() => {\r\n        toast.success(\"Generating NDR Successful!\");\r\n        setModal(false);\r\n        setProcessing(false);\r\n        setSelectPatients([]);\r\n        props.setValue(redirectTab);\r\n      }, 3000);\r\n    } catch (error) {\r\n      setModal(false);\r\n      setProcessing(false);\r\n\r\n      const errorMessage =\r\n        error?.response?.data?.apierror?.message?.trim() ||\r\n        \"Something went wrong. Please try again.\";\r\n\r\n      toast.error(errorMessage);\r\n    }\r\n  }, [\r\n    facilityQueryString,\r\n    generationMode,\r\n    selectPatients,\r\n    objValues,\r\n    status,\r\n    dateRangeInvalid,\r\n    props,\r\n  ]);\r\n\r\n  const canGenerate = checked.length >= 1 && !processing && !dateRangeInvalid;\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n\r\n      <Card className={classes.card}>\r\n        <CardBody>\r\n          {/* Info alert */}\r\n          <Alert severity=\"info\">\r\n            <AlertTitle>Generate NDR</AlertTitle>\r\n            Select facilities, choose a data type, and optionally provide a date\r\n            range or select specific patients. You'll be redirected to the\r\n            Downloads tab once the file is ready.\r\n          </Alert>\r\n\r\n          {/* ---------- Date Range Section ---------- */}\r\n          <div className={classes.sectionCard} style={{ marginTop: 24 }}>\r\n            <div className={classes.sectionTitle}>\r\n              <CalendarTodayIcon style={{ fontSize: 18 }} />\r\n              Optional: Generate by Date Range\r\n            </div>\r\n            <div className=\"row\">\r\n              <div className=\"col-md-5\">\r\n                <FormGroup>\r\n                  <Label>From</Label>\r\n                  <input\r\n                    type=\"date\"\r\n                    className={classes.dateInput}\r\n                    name=\"startDate\"\r\n                    id=\"startDate\"\r\n                    min=\"1980-01-01\"\r\n                    max={currentDate}\r\n                    value={objValues.startDate}\r\n                    onChange={handleInputChange}\r\n                  />\r\n                </FormGroup>\r\n              </div>\r\n              <div className=\"col-md-5\">\r\n                <FormGroup>\r\n                  <Label>To</Label>\r\n                  <input\r\n                    type=\"date\"\r\n                    className={classes.dateInput}\r\n                    name=\"endDate\"\r\n                    id=\"endDate\"\r\n                    min={objValues.startDate || \"1980-01-01\"}\r\n                    max={currentDate}\r\n                    value={objValues.endDate}\r\n                    onChange={handleInputChange}\r\n                  />\r\n                </FormGroup>\r\n              </div>\r\n              <div className=\"col-md-2 d-flex align-items-center\">\r\n                {(objValues.startDate || objValues.endDate) && (\r\n                  <Button\r\n                    size=\"small\"\r\n                    onClick={clearDateRange}\r\n                    style={{\r\n                      textTransform: \"none\",\r\n                      color: \"#5c6bc0\",\r\n                      marginTop: 20,\r\n                    }}\r\n                  >\r\n                    Clear dates\r\n                  </Button>\r\n                )}\r\n              </div>\r\n            </div>\r\n            {dateRangeInvalid && (\r\n              <div\r\n                style={{\r\n                  color: \"#d32f2f\",\r\n                  fontSize: \"0.78rem\",\r\n                  marginTop: 4,\r\n                }}\r\n              >\r\n                End date must be after start date.\r\n              </div>\r\n            )}\r\n            <div className={classes.modeHint}>\r\n              {generationMode === \"patients\" &&\r\n                \"Mode: Selected patients (overrides date range)\"}\r\n              {generationMode === \"date-range\" && \"Mode: Date range filter\"}\r\n              {generationMode === \"default\" &&\r\n                \"Mode: Default export (all eligible records)\"}\r\n            </div>\r\n          </div>\r\n\r\n          {/* ---------- Facilities + Type + Action ---------- */}\r\n          <div className=\"row\">\r\n            {/* Facilities */}\r\n            <div className=\"col-md-5\">\r\n              <div className={classes.sectionTitle}>\r\n                <AccountBalanceIcon style={{ fontSize: 18 }} />\r\n                Facilities\r\n                {checked.length > 0 && (\r\n                  <span className={classes.selectedCounter}>\r\n                    {checked.length} selected\r\n                  </span>\r\n                )}\r\n              </div>\r\n              {facilities.length > 0 ? (\r\n                facilities.map((value) => {\r\n                  const isChecked = checked.indexOf(value) !== -1;\r\n                  return (\r\n                    <div\r\n                      key={value.facilityId}\r\n                      className={classes.facilityItem}\r\n                      onClick={handleToggle(value)}\r\n                      role=\"button\"\r\n                      tabIndex={0}\r\n                      onKeyDown={(e) =>\r\n                        e.key === \"Enter\" && handleToggle(value)()\r\n                      }\r\n                      style={{\r\n                        backgroundColor: isChecked ? \"#e8eaf6\" : undefined,\r\n                        marginBottom: 8,\r\n                      }}\r\n                    >\r\n                      <input\r\n                        type=\"checkbox\"\r\n                        checked={isChecked}\r\n                        onChange={handleToggle(value)}\r\n                        onClick={(e) => e.stopPropagation()}\r\n                        style={{ marginRight: 12, cursor: \"pointer\" }}\r\n                      />\r\n                      <AccountBalanceIcon className={classes.facilityIcon} />\r\n                      <span className={classes.facilityName}>\r\n                        {value.facility}\r\n                      </span>\r\n                    </div>\r\n                  );\r\n                })\r\n              ) : (\r\n                <div\r\n                  style={{\r\n                    padding: 24,\r\n                    textAlign: \"center\",\r\n                    color: \"#9e9e9e\",\r\n                    fontSize: \"0.85rem\",\r\n                  }}\r\n                >\r\n                  No facilities available\r\n                </div>\r\n              )}\r\n            </div>\r\n\r\n            {/* Data Type */}\r\n            <div className=\"col-md-3\">\r\n              <div className={classes.sectionTitle}>Data Type</div>\r\n              <div\r\n                className={classes.radioGroup}\r\n                style={{ flexDirection: \"column\", gap: 12 }}\r\n              >\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === false}\r\n                    onChange={() => setStatus(false)}\r\n                  />\r\n                  Updated\r\n                </label>\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === true}\r\n                    onChange={() => setStatus(true)}\r\n                  />\r\n                  Initial\r\n                </label>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Action */}\r\n            <div className=\"col-md-4 d-flex flex-column justify-content-between\">\r\n              <div className={classes.sectionTitle}>Action</div>\r\n              <Button\r\n                variant=\"contained\"\r\n                className={classes.generateBtn}\r\n                disabled={!canGenerate}\r\n                onClick={generateAction}\r\n                startIcon={\r\n                  processing ? (\r\n                    <CircularProgress size={18} style={{ color: \"#fff\" }} />\r\n                  ) : (\r\n                    <GiFiles />\r\n                  )\r\n                }\r\n              >\r\n                {processing ? \"Generating...\" : \"Generate NDR\"}\r\n              </Button>\r\n              {selectPatients.length > 0 && (\r\n                <div\r\n                  style={{\r\n                    fontSize: \"0.78rem\",\r\n                    color: \"#5c6bc0\",\r\n                    marginTop: 8,\r\n                  }}\r\n                >\r\n                  {selectPatients.length} patient(s) selected — will override\r\n                  date range\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"mt-4\">\r\n            <MaterialTable\r\n              icons={tableIcons}\r\n              title=\"Eligible Patients\"\r\n              columns={[\r\n                { title: \"Patient Name\", field: \"name\", hidden: !showPPI },\r\n                { title: \"Unique ID\", field: \"uniqueId\", filtering: false },\r\n                { title: \"Sex\", field: \"sex\", filtering: false },\r\n                { title: \"Patient UUID\", field: \"uuid\", filtering: false },\r\n                { title: \"ART Status\", field: \"status\", filtering: false },\r\n              ]}\r\n              data={(query) =>\r\n                new Promise((resolve) =>\r\n                  axios\r\n                    .get(\r\n                      `${baseUrl}hiv/patient/enrollment/list?pageSize=${query.pageSize}&pageNo=${query.page}&searchValue=${query.search}`,\r\n                      { headers: { Authorization: `Bearer ${token}` } },\r\n                    )\r\n                    .then((response) => response)\r\n                    .then((result) => {\r\n                      resolve({\r\n                        data: result.data.records.map((row) => ({\r\n                          name:\r\n                            row.currentStatus !== \"Not Enrolled\" ? (\r\n                              <Link\r\n                                to={{ state: { patientObj: row } }}\r\n                                title=\"Click to view patient dashboard\"\r\n                              >\r\n                                {row.firstName + \" \" + row.surname}\r\n                              </Link>\r\n                            ) : (\r\n                              <Link\r\n                                to={{\r\n                                  state: {\r\n                                    patientId: row.id,\r\n                                    patientObj: row,\r\n                                  },\r\n                                }}\r\n                                title=\"Enroll Patient\"\r\n                              >\r\n                                {row.firstName + \" \" + row.surname}\r\n                              </Link>\r\n                            ),\r\n                          uniqueId: row.uniqueId,\r\n                          sex: row.sex,\r\n                          uuid: row.personUuid,\r\n                          status: (\r\n                            <Label color=\"blue\" size=\"mini\">\r\n                              {row.currentStatus}\r\n                            </Label>\r\n                          ),\r\n                        })),\r\n                        page: query.page,\r\n                        totalCount: result.data.totalRecords,\r\n                      });\r\n                    })\r\n                    .catch(() => {\r\n                      resolve({ data: [], page: 0, totalCount: 0 });\r\n                      toast.error(\"Failed to load patients.\");\r\n                    })\r\n                    .finally(() => setSelectedRows([])),\r\n                )\r\n              }\r\n              options={{\r\n                search: true,\r\n                selection: true,\r\n                headerStyle: {\r\n                  backgroundColor: \"#014d88\",\r\n                  color: \"#fff\",\r\n                  fontWeight: 600,\r\n                },\r\n                rowStyle: (rowData) => ({\r\n                  backgroundColor: selectedRows.find(\r\n                    (row) => row.tableData.id === rowData.tableData.id,\r\n                  )\r\n                    ? \"#e8f5e9\"\r\n                    : \"\",\r\n                }),\r\n                filtering: false,\r\n                exportButton: false,\r\n                searchFieldAlignment: \"left\",\r\n                pageSizeOptions: [10, 20, 100],\r\n                pageSize: 10,\r\n                debounceInterval: 400,\r\n              }}\r\n              components={{\r\n                Toolbar: (toolbarProps) => (\r\n                  <div>\r\n                    <div\r\n                      style={{\r\n                        display: \"flex\",\r\n                        alignItems: \"center\",\r\n                        padding: \"12px 16px\",\r\n                        gap: 8,\r\n                      }}\r\n                    >\r\n                      <input\r\n                        type=\"checkbox\"\r\n                        id=\"showPPI\"\r\n                        checked={showPPI}\r\n                        onChange={(e) => setShowPPI(e.target.checked)}\r\n                        style={{ cursor: \"pointer\" }}\r\n                      />\r\n                      <label\r\n                        htmlFor=\"showPPI\"\r\n                        style={{\r\n                          color: \"#014d88\",\r\n                          fontWeight: 600,\r\n                          fontSize: \"0.8rem\",\r\n                          cursor: \"pointer\",\r\n                          margin: 0,\r\n                        }}\r\n                      >\r\n                        SHOW PII\r\n                      </label>\r\n                    </div>\r\n                    <MTableToolbar {...toolbarProps} />\r\n                  </div>\r\n                ),\r\n              }}\r\n              onSelectionChange={handleRowSelection}\r\n            />\r\n          </div>\r\n        </CardBody>\r\n      </Card>\r\n\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={() => setModal(false)}\r\n        backdrop=\"static\"\r\n        centered\r\n        size=\"md\"\r\n      >\r\n        <ModalBody className={classes.modalBody}>\r\n          <CircularProgress size={48} style={{ color: \"#014d88\" }} />\r\n          <div className={classes.modalTitle} style={{ marginTop: 20 }}>\r\n            Generating NDR File\r\n          </div>\r\n          <div className={classes.modalSubtext}>\r\n            Please wait while we process your request. This may take a few\r\n            moments.\r\n          </div>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\PageUtils.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\download.js",["97","98","99","100","101","102","103"],"import React, { forwardRef, useEffect, useState } from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport * as api from \"./../../../api\";\r\nimport axios from \"axios\";\r\nimport { Modal, ModalBody, ModalHeader } from \"reactstrap\";\r\nimport { Link } from \"react-router-dom\";\r\nimport MaterialTable from \"material-table\";\r\nimport CloudUpload from \"@material-ui/icons/CloudUpload\";\r\nimport CloudDownloadIcon from \"@material-ui/icons/CloudDownload\";\r\nimport ErrorIcon from \"@mui/icons-material/Error\";\r\nimport { FiUploadCloud } from \"react-icons/fi\";\r\nimport FileSaver from \"file-saver\";\r\nimport \"semantic-ui-css/semantic.min.css\";\r\nimport { Dropdown, Button as Buuton2, Menu, Icon } from \"semantic-ui-react\";\r\nimport { token as token } from \"./../../../api\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport ProgressBar from \"react-bootstrap/ProgressBar\";\r\n\r\nimport AddBox from \"@material-ui/icons/AddBox\";\r\nimport ArrowUpward from \"@material-ui/icons/ArrowUpward\";\r\nimport Check from \"@material-ui/icons/Check\";\r\nimport ChevronLeft from \"@material-ui/icons/ChevronLeft\";\r\nimport ChevronRight from \"@material-ui/icons/ChevronRight\";\r\nimport Clear from \"@material-ui/icons/Clear\";\r\nimport DeleteOutline from \"@material-ui/icons/DeleteOutline\";\r\nimport Edit from \"@material-ui/icons/Edit\";\r\nimport FilterList from \"@material-ui/icons/FilterList\";\r\nimport FirstPage from \"@material-ui/icons/FirstPage\";\r\nimport LastPage from \"@material-ui/icons/LastPage\";\r\nimport Remove from \"@material-ui/icons/Remove\";\r\nimport SaveAlt from \"@material-ui/icons/SaveAlt\";\r\nimport Search from \"@material-ui/icons/Search\";\r\nimport ViewColumn from \"@material-ui/icons/ViewColumn\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport moment from \"moment\";\r\n\r\nconst tableIcons = {\r\n  Add: forwardRef((props, ref) => <AddBox {...props} ref={ref} />),\r\n  Check: forwardRef((props, ref) => <Check {...props} ref={ref} />),\r\n  Clear: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref} />),\r\n  DetailPanel: forwardRef((props, ref) => (\r\n    <ChevronRight {...props} ref={ref} />\r\n  )),\r\n  Edit: forwardRef((props, ref) => <Edit {...props} ref={ref} />),\r\n  Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref} />),\r\n  Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref} />),\r\n  FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref} />),\r\n  LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref} />),\r\n  NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref} />),\r\n  PreviousPage: forwardRef((props, ref) => (\r\n    <ChevronLeft {...props} ref={ref} />\r\n  )),\r\n  ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Search: forwardRef((props, ref) => <Search {...props} ref={ref} />),\r\n  SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref} />),\r\n  ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref} />),\r\n  ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref} />),\r\n};\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    width: \"100%\",\r\n    maxWidth: 360,\r\n    backgroundColor: theme.palette.background.paper,\r\n    \"& > * + *\": {\r\n      marginTop: theme.spacing(2),\r\n    },\r\n  },\r\n}));\r\n\r\nexport default function DownloadNdr(props) {\r\n  const classes = useStyles();\r\n  const [generatedNdrListed, setGeneratedNdrList] = useState([]);\r\n  const [loading, setLoading] = useState(\"\");\r\n  const [modal, setModal] = useState(false);\r\n  const toggle = () => setModal(!modal);\r\n\r\n  useEffect(() => {\r\n    generatedNdrList();\r\n  }, []);\r\n\r\n  //Load NDR WEB in the modal\\\r\n  const loadNdrWeb = () => {\r\n    toggle();\r\n  };\r\n\r\n  ///GET LIST OF FACILITIES\r\n  async function generatedNdrList() {\r\n    axios\r\n      .get(`${api.url}ndr/files`, {\r\n        headers: { Authorization: `Bearer ${api.token}` },\r\n      })\r\n      .then((response) => {\r\n        //console.log(response.data);\r\n        setGeneratedNdrList(response.data);\r\n        //console.log(response.data);\r\n      })\r\n      .catch((error) => {});\r\n  }\r\n\r\n  const gotoErrorTable = (id) => {\r\n    axios\r\n      .get(`${api.url}ndr/file/error/${id}`, {\r\n        headers: { Authorization: `Bearer ${api.token}` },\r\n      })\r\n      .then((response) => {\r\n        //console.log(response.data);\r\n        props.setErrors(response.data);\r\n        //console.log(response.data);\r\n      })\r\n      .catch((error) => {});\r\n    props.setValue(4);\r\n  };\r\n\r\n  const downloadFile = (fileName) => {\r\n    if (fileName.includes(\"redacted\")) {\r\n      axios\r\n        .get(`${api.url}ndr/download_redacted/${fileName}`, {\r\n          headers: { Authorization: `Bearer ${api.token}` },\r\n          responseType: \"blob\",\r\n        })\r\n        .then((response) => {\r\n          const responseData = response.data;\r\n          let blob = new Blob([responseData], {\r\n            type: \"application/octet-stream\",\r\n          });\r\n          FileSaver.saveAs(blob, `${fileName}.zip`);\r\n        })\r\n        .catch((error) => {});\r\n    } else {\r\n      axios\r\n        .get(`${api.url}ndr/download/${fileName}`, {\r\n          headers: { Authorization: `Bearer ${api.token}` },\r\n          responseType: \"blob\",\r\n        })\r\n        .then((response) => {\r\n          const responseData = response.data;\r\n          let blob = new Blob([responseData], {\r\n            type: \"application/octet-stream\",\r\n          });\r\n          FileSaver.saveAs(blob, `${fileName}.zip`);\r\n        })\r\n        .catch((error) => {});\r\n    }\r\n  };\r\n  const generateAction = (ndrFileId) => {\r\n    setModal(true);\r\n    //const fileID ={id: ndrFileId }\r\n    //SENDING A POST REQUEST\r\n    axios\r\n      .get(`${api.url}ndr-emr/ndr-auto-pusher?id=${ndrFileId}`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        window.setTimeout(() => {\r\n          toast.success(\" Uploading To NDR Successful!\");\r\n          setModal(false);\r\n          generatedNdrList();\r\n        }, 5000);\r\n\r\n        //props.history.push(\"/generate\", { state: 'download'});\r\n      })\r\n      .catch((error) => {\r\n        setModal(false);\r\n        //toast.error(\" Something went wrong!\");\r\n        if (error.response && error.response.data) {\r\n          let errorMessage =\r\n            error.response.data.apierror &&\r\n            error.response.data.apierror.message !== \"\"\r\n              ? error.response.data.apierror.message\r\n              : \"Something went wrong, please try again\";\r\n          toast.error(errorMessage);\r\n        } else {\r\n          toast.error(\"Something went wrong. Please try again...\");\r\n        }\r\n      });\r\n  };\r\n\r\n  const varient = (value) => {\r\n    //console.log(value);\r\n    if (value <= 20) {\r\n      return \"danger\";\r\n    } else if (value > 20 && value <= 69) {\r\n      return \"warning\";\r\n    } else if (value >= 70 && value <= 99) {\r\n      return \"info\";\r\n    } else if (value === 100) {\r\n      return \"success\";\r\n    } else {\r\n      return \"success\";\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n      <Button\r\n        variant=\"contained\"\r\n        color=\"primary\"\r\n        className=\" float-right\"\r\n        startIcon={<FiUploadCloud size=\"10\" />}\r\n        style={{ backgroundColor: \"#014d88\" }}\r\n        href=\"https://ndr.phis3project.org.ng/Identity/Account/Login?ReturnUrl=%2F\"\r\n        //onClick={loadNdrWeb}\r\n        target=\"_blank\"\r\n      >\r\n        <span> NDR Portal</span>\r\n      </Button>\r\n\r\n      <br />\r\n      <br />\r\n      <MaterialTable\r\n        icons={tableIcons}\r\n        title=\"List of Files Generated\"\r\n        columns={[\r\n          { title: \"Facility Name\", field: \"name\", filtering: false },\r\n          {\r\n            title: \"Number of Files Generated\",\r\n            field: \"files\",\r\n            filtering: false,\r\n          },\r\n          { title: \"File Name\", field: \"fileName\", filtering: false },\r\n          {\r\n            title: \"Date Last Generated\",\r\n            field: \"date\",\r\n            type: \"date\",\r\n            filtering: false,\r\n          },\r\n          {\r\n            title: \"NDR Upload Status\",\r\n            field: \"ndrStatus\",\r\n            type: \"date\",\r\n            filtering: false,\r\n          },\r\n\r\n          {\r\n            title: \"Action\",\r\n            field: \"actions\",\r\n            filtering: false,\r\n          },\r\n        ]}\r\n        isLoading={loading}\r\n        data={generatedNdrListed.map((row) => ({\r\n          name: row.facility,\r\n          files: row.files,\r\n          fileName: row.fileName,\r\n          date: moment(row.lastModified).format(\"LLLL\"),\r\n          ndrStatus: (\r\n            <ProgressBar\r\n              now={row.percentagePushed}\r\n              variant={varient(row.percentagePushed)}\r\n              label={`${row.percentagePushed}%`}\r\n            />\r\n          ),\r\n          actions: (\r\n            <div>\r\n              <Menu.Menu position=\"right\">\r\n                <Menu.Item>\r\n                  <Buuton2\r\n                    style={{ backgroundColor: \"rgb(153,46,98)\" }}\r\n                    primary\r\n                  >\r\n                    <Dropdown item text=\"Action\">\r\n                      <Dropdown.Menu style={{ marginTop: \"10px\" }}>\r\n                        <Dropdown.Item\r\n                          onClick={() => downloadFile(row.fileName)}\r\n                        >\r\n                          <CloudDownloadIcon color=\"primary\" /> Download File\r\n                        </Dropdown.Item>\r\n                        <Dropdown.Item onClick={() => gotoErrorTable(row.id)}>\r\n                          <ErrorIcon color=\"error\" />\r\n                          Error File\r\n                        </Dropdown.Item>\r\n                        {!row.completelyPushed && (\r\n                          <Dropdown.Item onClick={() => generateAction(row.id)}>\r\n                            <CloudUpload color=\"primary\" /> Upload To NDR\r\n                          </Dropdown.Item>\r\n                        )}\r\n                      </Dropdown.Menu>\r\n                    </Dropdown>\r\n                  </Buuton2>\r\n                </Menu.Item>\r\n              </Menu.Menu>\r\n            </div>\r\n          ),\r\n        }))}\r\n        options={{\r\n          pageSizeOptions: [5, 10, 50, 100, 150, 500],\r\n          headerStyle: {\r\n            backgroundColor: \"#014d88\",\r\n            color: \"#fff\",\r\n            margin: \"auto\",\r\n          },\r\n          filtering: true,\r\n          searchFieldStyle: {\r\n            width: \"300%\",\r\n            margingLeft: \"250px\",\r\n          },\r\n          exportButton: false,\r\n          searchFieldAlignment: \"left\",\r\n        }}\r\n      />\r\n\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={toggle}\r\n        backdrop={false}\r\n        fade={true}\r\n        style={{ marginTop: \"250px\" }}\r\n        size=\"lg\"\r\n      >\r\n        <ModalBody>\r\n          <h1>Uploading File To NDR. Please wait...</h1>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Biometrics.js",["104","105","106","107"],"import React, { useState, useEffect, useCallback, useMemo } from \"react\";\r\nimport { Row, Col, CardBody, Card } from \"reactstrap\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport axios from \"axios\";\r\nimport * as api from \"./../../../api\";\r\nimport { token as token, url as baseUrl } from \"./../../../api\";\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport FingerprintIcon from \"@mui/icons-material/Fingerprint\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport { Alert, AlertTitle } from \"@material-ui/lab\";\r\nimport CircularProgress from \"@mui/material/CircularProgress\";\r\nimport { Modal, ModalBody } from \"reactstrap\";\r\n\r\n// ---------- Styles ----------\r\nconst useStyles = makeStyles((theme) => ({\r\n  card: {\r\n    border: \"none\",\r\n    borderRadius: 10,\r\n    boxShadow: \"0 2px 12px rgba(0,0,0,0.06)\",\r\n  },\r\n  headerRow: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    justifyContent: \"space-between\",\r\n    flexWrap: \"wrap\",\r\n    gap: theme.spacing(2),\r\n    marginBottom: theme.spacing(3),\r\n  },\r\n  sectionTitle: {\r\n    fontSize: \"0.95rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1),\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n  },\r\n  facilityPanel: {\r\n    backgroundColor: \"#fff\",\r\n    border: \"1px solid #e8eaf6\",\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1),\r\n    maxHeight: 360,\r\n    overflowY: \"auto\",\r\n  },\r\n  facilityItem: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    padding: \"10px 12px\",\r\n    borderRadius: 6,\r\n    cursor: \"pointer\",\r\n    transition: \"background-color 0.15s ease\",\r\n    marginBottom: 4,\r\n    \"&:hover\": {\r\n      backgroundColor: \"#f0f2ff\",\r\n    },\r\n  },\r\n  facilityIcon: {\r\n    color: \"#5c6bc0\",\r\n    fontSize: \"1.25rem\",\r\n    marginRight: theme.spacing(1.5),\r\n  },\r\n  facilityName: {\r\n    flex: 1,\r\n    fontSize: \"0.875rem\",\r\n    color: \"#333\",\r\n    fontWeight: 500,\r\n  },\r\n  generateBtn: {\r\n    backgroundColor: \"#014d88\",\r\n    color: \"#fff\",\r\n    textTransform: \"none\",\r\n    fontWeight: 600,\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1.2, 3),\r\n    boxShadow: \"0 2px 8px rgba(1,77,136,0.25)\",\r\n    \"&:hover\": {\r\n      backgroundColor: \"#013a66\",\r\n      boxShadow: \"0 4px 12px rgba(1,77,136,0.35)\",\r\n    },\r\n    \"&:disabled\": {\r\n      backgroundColor: \"#b0bec5\",\r\n      color: \"#fff\",\r\n      boxShadow: \"none\",\r\n    },\r\n  },\r\n  emptyState: {\r\n    padding: theme.spacing(5),\r\n    textAlign: \"center\",\r\n    color: \"#9e9e9e\",\r\n    fontSize: \"0.875rem\",\r\n  },\r\n  modalBody: {\r\n    padding: theme.spacing(5),\r\n    textAlign: \"center\",\r\n  },\r\n  modalTitle: {\r\n    fontSize: \"1.1rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1.5),\r\n  },\r\n  modalSubtext: {\r\n    color: \"#666\",\r\n    fontSize: \"0.85rem\",\r\n  },\r\n  selectedCounter: {\r\n    display: \"inline-flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n    padding: \"4px 12px\",\r\n    backgroundColor: \"#e8eaf6\",\r\n    borderRadius: 20,\r\n    fontSize: \"0.78rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginLeft: theme.spacing(1),\r\n  },\r\n}));\r\n\r\nconst Biometrics = (props) => {\r\n  const classes = useStyles();\r\n  const [facilities, setFacilities] = useState([]);\r\n  const [checked, setChecked] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [processing, setProcessing] = useState(false);\r\n\r\n  useEffect(() => {\r\n    let isMounted = true;\r\n    axios\r\n      .get(`${api.url}account`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        if (!isMounted) return;\r\n        setFacilities(response.data.applicationUserOrganisationUnits || []);\r\n      })\r\n      .catch(() => {\r\n        toast.error(\"Unable to load facilities. Please refresh the page.\");\r\n      });\r\n    return () => {\r\n      isMounted = false;\r\n    };\r\n  }, []);\r\n\r\n  const handleToggle = useCallback(\r\n    (value) => () => {\r\n      setChecked((prev) => {\r\n        const currentIndex = prev.indexOf(value);\r\n        const newChecked = [...prev];\r\n        if (currentIndex === -1) newChecked.push(value);\r\n        else newChecked.splice(currentIndex, 1);\r\n        return newChecked;\r\n      });\r\n    },\r\n    [],\r\n  );\r\n\r\n  const facilityQueryString = useMemo(() => {\r\n    return checked\r\n      .map((value) => `facilityIds=${value.organisationUnitId}`)\r\n      .join(\"&\");\r\n  }, [checked]);\r\n\r\n  const generateBiometrics = useCallback(async () => {\r\n    if (!facilityQueryString) {\r\n      toast.warn(\"Please select at least one facility.\");\r\n      return;\r\n    }\r\n\r\n    setProcessing(true);\r\n    setModal(true);\r\n\r\n    try {\r\n      await axios.get(\r\n        `${api.url}ndr/recapture/generate?${facilityQueryString}`,\r\n        {\r\n          headers: { Authorization: `Bearer ${token}` },\r\n        },\r\n      );\r\n\r\n      window.setTimeout(() => {\r\n        toast.success(\"Generating Biometrics XML Successful!\");\r\n        setModal(false);\r\n        setProcessing(false);\r\n        setChecked([]);\r\n        props.setValue(4);\r\n      }, 3000);\r\n    } catch (error) {\r\n      setModal(false);\r\n      setProcessing(false);\r\n\r\n      const errorMessage =\r\n        error?.response?.data?.apierror?.message?.trim() ||\r\n        \"Something went wrong. Please try again.\";\r\n\r\n      toast.error(errorMessage);\r\n    }\r\n  }, [facilityQueryString, props]);\r\n\r\n  const canGenerate = checked.length >= 1 && !processing;\r\n  const hasFacilities = facilities.length > 0;\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n\r\n      <Card className={classes.card}>\r\n        <CardBody>\r\n          {/* Info alert */}\r\n          <Alert severity=\"info\">\r\n            <AlertTitle>Generate Biometrics Recapture XML</AlertTitle>\r\n            Select the facilities whose biometrics you want to recapture, then\r\n            click <strong>Generate Biometrics XML</strong>. You'll be redirected\r\n            to the Downloads tab once the file is ready.\r\n          </Alert>\r\n\r\n          {/* Header row */}\r\n          <div className={classes.headerRow} style={{ marginTop: 24 }}>\r\n            <div className={classes.sectionTitle}>\r\n              <AccountBalanceIcon style={{ fontSize: 18 }} />\r\n              Select Facilities\r\n              {checked.length > 0 && (\r\n                <span className={classes.selectedCounter}>\r\n                  {checked.length} selected\r\n                </span>\r\n              )}\r\n            </div>\r\n\r\n            <Button\r\n              variant=\"contained\"\r\n              className={classes.generateBtn}\r\n              disabled={!canGenerate}\r\n              onClick={generateBiometrics}\r\n              startIcon={\r\n                processing ? (\r\n                  <CircularProgress size={18} style={{ color: \"#fff\" }} />\r\n                ) : (\r\n                  <FingerprintIcon />\r\n                )\r\n              }\r\n            >\r\n              {processing ? \"Generating...\" : \"Generate Biometrics XML\"}\r\n            </Button>\r\n          </div>\r\n\r\n          <div className={classes.facilityPanel}>\r\n            {hasFacilities ? (\r\n              facilities.map((value) => {\r\n                const isChecked = checked.indexOf(value) !== -1;\r\n                return (\r\n                  <div\r\n                    key={value.id}\r\n                    className={classes.facilityItem}\r\n                    onClick={handleToggle(value)}\r\n                    role=\"button\"\r\n                    tabIndex={0}\r\n                    onKeyDown={(e) =>\r\n                      e.key === \"Enter\" && handleToggle(value)()\r\n                    }\r\n                    style={{\r\n                      backgroundColor: isChecked ? \"#e8eaf6\" : undefined,\r\n                    }}\r\n                  >\r\n                    <input\r\n                      type=\"checkbox\"\r\n                      checked={isChecked}\r\n                      onChange={handleToggle(value)}\r\n                      onClick={(e) => e.stopPropagation()}\r\n                      style={{ marginRight: 12, cursor: \"pointer\" }}\r\n                    />\r\n                    <AccountBalanceIcon className={classes.facilityIcon} />\r\n                    <span className={classes.facilityName}>\r\n                      {value.organisationUnitName}\r\n                    </span>\r\n                  </div>\r\n                );\r\n              })\r\n            ) : (\r\n              <div className={classes.emptyState}>\r\n                No facilities available for your account\r\n              </div>\r\n            )}\r\n          </div>\r\n        </CardBody>\r\n      </Card>\r\n\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={() => setModal(false)}\r\n        backdrop=\"static\"\r\n        centered\r\n        size=\"md\"\r\n      >\r\n        <ModalBody className={classes.modalBody}>\r\n          <CircularProgress size={48} style={{ color: \"#014d88\" }} />\r\n          <div className={classes.modalTitle} style={{ marginTop: 20 }}>\r\n            Generating Biometrics XML\r\n          </div>\r\n          <div className={classes.modalSubtext}>\r\n            Please wait while we process your request. This may take a few\r\n            moments.\r\n          </div>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Biometrics;\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\NdrConfiguration.js",["108","109","110","111","112"],"import React, {forwardRef, useEffect, useState} from 'react';\r\nimport * as api from \"./../../../api\";\r\nimport axios from \"axios\";\r\nimport {Modal} from 'reactstrap';\r\nimport {  Modal as Modal2} from \"react-bootstrap\";\r\nimport MaterialTable from 'material-table';\r\nimport {FiUploadCloud} from \"react-icons/fi\";\r\nimport 'semantic-ui-css/semantic.min.css';\r\nimport { Dropdown,Button as Buuton2, Menu, Icon } from 'semantic-ui-react'\r\nimport { token as token, } from \"./../../../api\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport NdrConfigurationSetup from './NdrConfigurationSetup'\r\n\r\n\r\nimport AddBox from '@material-ui/icons/AddBox';\r\nimport ArrowUpward from '@material-ui/icons/ArrowUpward';\r\nimport Check from '@material-ui/icons/Check';\r\nimport ChevronLeft from '@material-ui/icons/ChevronLeft';\r\nimport ChevronRight from '@material-ui/icons/ChevronRight';\r\nimport Clear from '@material-ui/icons/Clear';\r\nimport DeleteOutline from '@material-ui/icons/DeleteOutline';\r\nimport Edit from '@material-ui/icons/Edit';\r\nimport FilterList from '@material-ui/icons/FilterList';\r\nimport FirstPage from '@material-ui/icons/FirstPage';\r\nimport LastPage from '@material-ui/icons/LastPage';\r\nimport Remove from '@material-ui/icons/Remove';\r\nimport SaveAlt from '@material-ui/icons/SaveAlt';\r\nimport Search from '@material-ui/icons/Search';\r\nimport ViewColumn from '@material-ui/icons/ViewColumn';\r\nimport Button from '@material-ui/core/Button';\r\n\r\n\r\nconst tableIcons = {\r\n    Add: forwardRef((props, ref) => <AddBox {...props} ref={ref}/>),\r\n    Check: forwardRef((props, ref) => <Check {...props} ref={ref}/>),\r\n    Clear: forwardRef((props, ref) => <Clear {...props} ref={ref}/>),\r\n    Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref}/>),\r\n    DetailPanel: forwardRef((props, ref) => <ChevronRight {...props} ref={ref}/>),\r\n    Edit: forwardRef((props, ref) => <Edit {...props} ref={ref}/>),\r\n    Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref}/>),\r\n    Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref}/>),\r\n    FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref}/>),\r\n    LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref}/>),\r\n    NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref}/>),\r\n    PreviousPage: forwardRef((props, ref) => <ChevronLeft {...props} ref={ref}/>),\r\n    ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref}/>),\r\n    Search: forwardRef((props, ref) => <Search {...props} ref={ref}/>),\r\n    SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref}/>),\r\n    ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref}/>),\r\n    ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref}/>)\r\n};\r\n\r\n\r\nexport default function DownloadNdr() {\r\n    const [setUpDetail, setSetUpDetail]= useState(\"\")\r\n    const [ndrDetail, setNdrDetail] = useState()\r\n    const [saving, setSaving] = useState(false)\r\n    const [modal, setModal] = useState(false);\r\n    const toggle = () => setModal(!modal);\r\n    const [showModal, setShowModal] = React.useState(false);\r\n    const toggleModal = () => setShowModal(!showModal)\r\n    useEffect(() => {\r\n        ndrSetup()\r\n    }, []);\r\n\r\n    ///GET LIST OF NDR SETUP\r\n    const ndrSetup =()=> {\r\n       \r\n        axios\r\n            .get(`${api.url}ndr-emr/auto-push-configuration-viewer`,\r\n                {headers: {\"Authorization\": `Bearer ${api.token}`}}\r\n            )\r\n            .then((response) => {\r\n                if(response.data!==\"\" && response.data!==null){\r\n                    setNdrDetail(response.data);\r\n                }else{\r\n                    setNdrDetail()\r\n                }\r\n            })\r\n            .catch((error) => {\r\n                ///console.log(error)\r\n            });\r\n\r\n    }\r\n\r\n    const deleteAccount = () => {\r\n        setSaving(true)\r\n        axios\r\n            .delete(`${api.url}ndr-emr/auto-push-configuration-deleter`,\r\n                {headers: {\"Authorization\": `Bearer ${api.token}`}}\r\n            )\r\n            .then((response) => {\r\n                toast.success(\" Record Deleted Successful!\");\r\n                ndrSetup();\r\n                toggle()\r\n                setSaving(false)\r\n            })\r\n            .catch((error) => {\r\n                setSaving(false)\r\n                setModal(!modal)\r\n            });\r\n    }\r\n    const  generateAction = (fileName) => {\r\n        setModal(true)\r\n       \r\n         //SENDING A POST REQUEST \r\n         axios.POST(`${api.url}ndr-emr/ndr-auto-pusher?id=${fileName}`, fileName,\r\n                     { headers: {\"Authorization\" : `Bearer ${token}`} }\r\n                   )\r\n                 .then(response => {\r\n                   window.setTimeout(() => {\r\n                     toast.success(\" Generating NDR Successful!\");\r\n                     setModal(false)\r\n                     //props.setValue(1)\r\n                   }, 5000);\r\n                   \r\n                   //props.history.push(\"/generate\", { state: 'download'});\r\n                 })\r\n                 .catch(error => {\r\n                   setModal(false)\r\n                   toast.error(\" Something went wrong!\");\r\n                   if(error.response && error.response.data){\r\n                     let errorMessage = error.response.data.apierror && error.response.data.apierror.message!==\"\" ? error.response.data.apierror.message :  \"Something went wrong, please try again\";\r\n                     toast.error(errorMessage);\r\n                   }\r\n                   else{\r\n                     toast.error(\"Something went wrong. Please try again...\");\r\n                   }\r\n                 });\r\n       }\r\n\r\n    const setupModal =(row)=> { \r\n              \r\n        setShowModal(!showModal)\r\n        setSetUpDetail(row)\r\n    }\r\n    const deleteModal =()=> {        \r\n        setModal(!modal)\r\n    }\r\n\r\n    \r\n    return (\r\n        <div>\r\n            <ToastContainer autoClose={3000} hideProgressBar />\r\n            {ndrDetail===undefined && (\r\n            <Button\r\n                variant=\"contained\"\r\n                color=\"primary\"\r\n                className=\" float-right\"\r\n                startIcon={<FiUploadCloud size=\"10\"/>}\r\n                style={{backgroundColor: '#014d88'}}\r\n                onClick={setupModal}\r\n              \r\n            >\r\n                <span> NDR Setup</span>\r\n            </Button>\r\n            )}\r\n            <br/><br/>\r\n            <MaterialTable\r\n                icons={tableIcons}\r\n                title=\"NDR Setup Detail\"\r\n\r\n                columns={[\r\n                    {title: \"Username\", field: \"username\", filtering: false},\r\n                    \r\n                    {title: \"Password\", field: \"password\", filtering: false},\r\n                    {\r\n                        title: \"Action\",\r\n                        field: \"actions\",\r\n                        filtering: false,\r\n                    },\r\n                ]}\r\n                //isLoading={loading}\r\n                data={ndrDetail &&  [ndrDetail].map((row) => ({\r\n                    username: row.username,\r\n                    password: row.password,\r\n                    actions:<div>\r\n                    <Menu.Menu position='right'  >\r\n                    <Menu.Item >\r\n                        <Buuton2 style={{backgroundColor:'rgb(153,46,98)'}} primary>\r\n                        <Dropdown item text='Action'>\r\n\r\n                        <Dropdown.Menu style={{ marginTop:\"10px\", }}>\r\n                            {/* <Dropdown.Item  onClick={() =>setupModal(row)}><Edit color=\"primary\"/> Edit\r\n                            </Dropdown.Item> */}\r\n                            <Dropdown.Item  onClick= {() => deleteModal(row.id)}><DeleteOutline color=\"primary\"/> Delete\r\n                            </Dropdown.Item>\r\n                        </Dropdown.Menu>\r\n                    </Dropdown>\r\n                        </Buuton2>\r\n                    </Menu.Item>\r\n                    </Menu.Menu>\r\n              </div>\r\n                }))}\r\n                options={{\r\n\r\n                    pageSizeOptions: [5,],\r\n                    headerStyle: {\r\n                        backgroundColor: \"#014d88\",\r\n                        color: \"#fff\",\r\n                        margin: \"auto\"\r\n                    },\r\n                    filtering: true,\r\n                    searchFieldStyle: {\r\n                        width: '200%',\r\n                        margingLeft: '250px',\r\n                    },\r\n                    exportButton: false,\r\n                    searchFieldAlignment: 'left',\r\n                }}\r\n\r\n            />\r\n\r\n        <Modal2 show={modal} toggle={toggle} className=\"fade\" size=\"md\"\r\n            aria-labelledby=\"contained-modal-title-vcenter\"\r\n            centered backdrop=\"static\">\r\n            <Modal2.Header >\r\n        <Modal2.Title id=\"contained-modal-title-vcenter\">\r\n            Notification!\r\n        </Modal2.Title>\r\n        </Modal2.Header>\r\n            <Modal2.Body>\r\n                <h4>Are you Sure you want to delete the record ?</h4>\r\n                \r\n            </Modal2.Body>\r\n        <Modal2.Footer>\r\n            <Button onClick={()=>deleteAccount()}  style={{backgroundColor:\"red\", color:\"#fff\"}} disabled={saving}>{saving===false ? \"Yes\": \"Deleting...\"}</Button>\r\n            <Button onClick={toggle} style={{backgroundColor:\"#014d88\", color:\"#fff\"}} disabled={saving}>No</Button>\r\n            \r\n        </Modal2.Footer>\r\n        </Modal2>      \r\n            <NdrConfigurationSetup toggleModal={toggleModal} showModal={showModal} NdrSetup={ndrSetup} setUpDetail={ndrDetail}/>\r\n        </div>\r\n\r\n    );\r\n\r\n}\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\api.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\NdrConfigurationSetup.js",["113","114","115","116"],"import React, {useState, useEffect} from 'react';\r\nimport { Modal, ModalHeader, ModalBody,Form,FormFeedback,\r\nRow,Col, Card,CardBody, FormGroup, Input, Label} from 'reactstrap';\r\nimport Button from '@material-ui/core/Button'\r\nimport { makeStyles } from '@material-ui/core/styles'\r\n\r\nimport { Spinner } from 'reactstrap';\r\nimport axios from \"axios\";\r\nimport {  toast } from 'react-toastify';\r\nimport 'react-toastify/dist/ReactToastify.css';\r\nimport { token as token,  url as baseUrl } from \"./../../../api\";\r\n\r\n\r\nconst useStyles = makeStyles(theme => ({\r\n    card: {\r\n        margin: theme.spacing(20),\r\n        display: 'flex',\r\n        flexDirection: 'column',\r\n        alignItems: 'center'\r\n    },\r\n    form: {\r\n        width: '100%', // Fix IE 11 issue.\r\n        marginTop: theme.spacing(3)\r\n    },\r\n    submit: {\r\n        margin: theme.spacing(3, 0, 2)\r\n    },\r\n    cardBottom: {\r\n        marginBottom: 20\r\n    },\r\n    Select: {\r\n        height: 45,\r\n        width: 350\r\n    },\r\n    button: {\r\n        margin: theme.spacing(1)\r\n    },\r\n\r\n    root: {\r\n        '& > *': {\r\n            margin: theme.spacing(1)\r\n        }\r\n    },\r\n    input: {\r\n        display: 'none'\r\n    },\r\n    error: {\r\n        color: \"#f85032\",\r\n        fontSize: \"11px\",\r\n    },\r\n    success: {\r\n        color: \"#4BB543 \",\r\n        fontSize: \"11px\",\r\n    }, \r\n}))\r\n\r\n\r\n\r\nconst DatabaseSyn = (props) => {\r\n    const classes = useStyles()\r\n    const defaultValues = { username: \"\", password: \"\"  }\r\n    //console.log(props)\r\n    const [patDetails, setPatDetails] = useState(defaultValues);\r\n    const [saving, setSaving] = useState(false);\r\n    const [errors, setErrors] = useState({});\r\n    \r\n    const handleInputChange = e => {\r\n      setPatDetails ({...patDetails,  [e.target.name]: e.target.value});\r\n    }\r\n    /*****  Validation */\r\n    const validate = () => {\r\n    let temp = { ...errors };\r\n    temp.username = patDetails.username\r\n        ? \"\"\r\n        : \"Username is required\";\r\n        temp.password = patDetails.password\r\n        ? \"\"\r\n        : \"Password is required\";\r\n        \r\n        setErrors({\r\n            ...temp,\r\n        });\r\n        return Object.values(temp).every((x) => x === \"\");\r\n    };\r\n\r\n    const handleSubmit = (e) => {\r\n      e.preventDefault();\r\n            if (validate()) {      \r\n                    setSaving(true);\r\n                    axios.post(`${baseUrl}ndr-emr/auto-push-configuration?username=${patDetails.username}&password=${patDetails.password}`,patDetails,\r\n                     { headers: {\"Authorization\" : `Bearer ${token}`}},\r\n                    \r\n                    ).then(response => {\r\n                            setSaving(false);\r\n                            props.NdrSetup()\r\n                            toast.success(\"NDR Setup Successful\");\r\n                            props.toggleModal()\r\n\r\n                    }).catch(error => {\r\n                            setSaving(false);\r\n                            if(error.response && error.response.data){\r\n                                let errorMessage = error.response.data.apierror && error.response.data.apierror.message!==\"\" ? error.response.data.apierror.message :  \"Something went wrong, please try again\";\r\n                                \r\n                                    toast.error(errorMessage, {position: toast.POSITION.BOTTOM_CENTER});\r\n                                \r\n                            }\r\n                            else{\r\n                                toast.error(\"Something went wrong. Please try again...\", {position: toast.POSITION.BOTTOM_CENTER});\r\n                            }\r\n                        \r\n                        });\r\n            }\r\n        }\r\n\r\n      \r\n  return (      \r\n      <div >\r\n         \r\n              <Modal isOpen={props.showModal} toggle={props.toggleModal} className={props.className} size=\"lg\" backdrop={false} backdrop=\"static\">\r\n              <Form >\r\n             <ModalHeader toggle={props.toggleModal}>NDR Setup</ModalHeader>\r\n                <ModalBody>\r\n                    \r\n                    <Card >\r\n                        <CardBody>\r\n                            <Row >\r\n                            <Col md={12}>\r\n                            <FormGroup>\r\n                            <Label >Username </Label>\r\n                                    <Input\r\n                                        type=\"text\"\r\n                                        name=\"username\"\r\n                                        id=\"username\" \r\n                                        value={patDetails.username}\r\n                                        onChange={handleInputChange}\r\n                                        required\r\n                                        />\r\n                                    {errors.username !==\"\" ? (\r\n                                        <span className={classes.error}>{errors.username}</span>\r\n                                    ) : \"\" }\r\n                            </FormGroup>\r\n                            </Col>\r\n                            <Col md={12}>\r\n                            <FormGroup>\r\n                            <Label >Password </Label>\r\n                                    <Input\r\n                                        type=\"password\"\r\n                                        name=\"password\"\r\n                                        id=\"password\" \r\n                                        value={patDetails.password}\r\n                                        onChange={handleInputChange}\r\n                                        required\r\n                                        />\r\n                                    {errors.password !==\"\" ? (\r\n                                        <span className={classes.error}>{errors.password}</span>\r\n                                    ) : \"\" }\r\n                            </FormGroup>\r\n                            </Col>                    \r\n                            </Row>\r\n                            {saving ? <Spinner /> : \"\"}\r\n                            <br/>              \r\n                            <Button\r\n                                type='submit'\r\n                                variant='contained'\r\n                                color='primary'\r\n                                \r\n                                //startIcon={<SettingsBackupRestoreIcon />}\r\n                                onClick={handleSubmit}\r\n                                \r\n                            >   \r\n                                <span style={{ textTransform: \"capitalize \" }}>Connect & Save</span>  \r\n                            </Button>\r\n                        </CardBody>\r\n                        </Card> \r\n                    </ModalBody>\r\n        \r\n                </Form>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport default DatabaseSyn;\r\n","C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Modul