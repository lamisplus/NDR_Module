rningCount":0,"source":null},{"filePath":"50","messages":"51","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"52","messages":"53","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"54","messages":"55","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"56","messages":"57","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"58","messages":"59","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"60","messages":"61","errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"62","messages":"63","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"64","messages":"65","errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"66","messages":"67","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"68","messages":"69","errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":1,"source":null},{"filePath":"70","messages":"71","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"72","usedDeprecatedRules":"73"},{"filePath":"74","messages":"75","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\index.js",["76"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\App.js",["77"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\reportWebVitals.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\context\\ThemeContext.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\context\\ThemeDemo.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Errors.js",["78","79","80","81","82"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Dashboard.js",["83"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\hts.js",["84","85"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Redact.js",["86","87","88","89"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\generate.js",["90","91"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\PageUtils.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\download.js",["92","93","94","95","96","97","98"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Biometrics.js",["99","100","101","102"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\NdrConfiguration.js",["103","104","105","106","107"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\api.js",[],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\NdrConfigurationSetup.js",["108","109","110","111"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Prep.js",["112","113"],"import React, {\r\n  useState,\r\n  useEffect,\r\n  forwardRef,\r\n  useCallback,\r\n  useMemo,\r\n} from \"react\";\r\nimport { makeStyles } from \"@material-ui/core/styles\";\r\nimport axios from \"axios\";\r\nimport * as api from \"./../../../api\";\r\nimport { token, url as baseUrl } from \"./../../../api\";\r\nimport { CardBody, Card } from \"reactstrap\";\r\nimport { Alert, AlertTitle } from \"@material-ui/lab\";\r\nimport { GiFiles } from \"react-icons/gi\";\r\nimport Button from \"@material-ui/core/Button\";\r\nimport AccountBalanceIcon from \"@material-ui/icons/AccountBalance\";\r\nimport MaterialTable, { MTableToolbar } from \"material-table\";\r\nimport { ToastContainer, toast } from \"react-toastify\";\r\nimport \"react-toastify/dist/ReactToastify.css\";\r\nimport \"react-widgets/dist/css/react-widgets.css\";\r\nimport { Modal, ModalBody } from \"reactstrap\";\r\nimport {\r\n  AddBox,\r\n  ArrowUpward,\r\n  Check,\r\n  ChevronLeft,\r\n  ChevronRight,\r\n  Clear,\r\n  DeleteOutline,\r\n  Edit,\r\n  FilterList,\r\n  FirstPage,\r\n  LastPage,\r\n  Remove,\r\n  SaveAlt,\r\n  Search,\r\n  ViewColumn,\r\n} from \"@material-ui/icons\";\r\nimport uniq from \"lodash/uniq\";\r\n\r\nconst tableIcons = {\r\n  Add: forwardRef((props, ref) => <AddBox {...props} ref={ref} />),\r\n  Check: forwardRef((props, ref) => <Check {...props} ref={ref} />),\r\n  Clear: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Delete: forwardRef((props, ref) => <DeleteOutline {...props} ref={ref} />),\r\n  DetailPanel: forwardRef((props, ref) => (\r\n    <ChevronRight {...props} ref={ref} />\r\n  )),\r\n  Edit: forwardRef((props, ref) => <Edit {...props} ref={ref} />),\r\n  Export: forwardRef((props, ref) => <SaveAlt {...props} ref={ref} />),\r\n  Filter: forwardRef((props, ref) => <FilterList {...props} ref={ref} />),\r\n  FirstPage: forwardRef((props, ref) => <FirstPage {...props} ref={ref} />),\r\n  LastPage: forwardRef((props, ref) => <LastPage {...props} ref={ref} />),\r\n  NextPage: forwardRef((props, ref) => <ChevronRight {...props} ref={ref} />),\r\n  PreviousPage: forwardRef((props, ref) => (\r\n    <ChevronLeft {...props} ref={ref} />\r\n  )),\r\n  ResetSearch: forwardRef((props, ref) => <Clear {...props} ref={ref} />),\r\n  Search: forwardRef((props, ref) => <Search {...props} ref={ref} />),\r\n  SortArrow: forwardRef((props, ref) => <ArrowUpward {...props} ref={ref} />),\r\n  ThirdStateCheck: forwardRef((props, ref) => <Remove {...props} ref={ref} />),\r\n  ViewColumn: forwardRef((props, ref) => <ViewColumn {...props} ref={ref} />),\r\n};\r\n\r\nconst useStyles = makeStyles((theme) => ({\r\n  root: {\r\n    width: \"100%\",\r\n  },\r\n  card: {\r\n    border: \"none\",\r\n    borderRadius: 10,\r\n    boxShadow: \"0 2px 12px rgba(0,0,0,0.06)\",\r\n  },\r\n  sectionTitle: {\r\n    fontSize: \"0.95rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(1),\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 6,\r\n  },\r\n  radioGroup: {\r\n    display: \"flex\",\r\n    gap: theme.spacing(3),\r\n    padding: theme.spacing(1.5, 2),\r\n    backgroundColor: \"#f8f9ff\",\r\n    borderRadius: 8,\r\n    border: \"1px solid #e8eaf6\",\r\n  },\r\n  radioLabel: {\r\n    display: \"flex\",\r\n    alignItems: \"center\",\r\n    gap: 8,\r\n    cursor: \"pointer\",\r\n    fontSize: \"0.875rem\",\r\n    fontWeight: 500,\r\n    color: \"#333\",\r\n    margin: 0,\r\n  },\r\n  facilityPanel: {\r\n    backgroundColor: \"#fff\",\r\n    border: \"1px solid #e8eaf6\",\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1),\r\n    maxHeight: 280,\r\n    overflowY: \"auto\",\r\n  },\r\n  facilityItem: {\r\n    borderRadius: 6,\r\n    marginBottom: 4,\r\n    \"&:hover\": {\r\n      backgroundColor: \"#f0f2ff\",\r\n    },\r\n  },\r\n  facilityIcon: {\r\n    minWidth: 36,\r\n    color: \"#5c6bc0\",\r\n  },\r\n  generateBtn: {\r\n    backgroundColor: \"#014d88\",\r\n    color: \"#fff\",\r\n    textTransform: \"none\",\r\n    fontWeight: 600,\r\n    borderRadius: 8,\r\n    padding: theme.spacing(1.2, 3),\r\n    boxShadow: \"0 2px 8px rgba(1,77,136,0.25)\",\r\n    \"&:hover\": {\r\n      backgroundColor: \"#013a66\",\r\n      boxShadow: \"0 4px 12px rgba(1,77,136,0.35)\",\r\n    },\r\n    \"&:disabled\": {\r\n      backgroundColor: \"#b0bec5\",\r\n      color: \"#fff\",\r\n    },\r\n  },\r\n  emptyState: {\r\n    padding: theme.spacing(4),\r\n    textAlign: \"center\",\r\n    color: \"#9e9e9e\",\r\n    fontSize: \"0.85rem\",\r\n  },\r\n  modalBody: {\r\n    padding: theme.spacing(4),\r\n    textAlign: \"center\",\r\n  },\r\n  modalTitle: {\r\n    fontSize: \"1.1rem\",\r\n    fontWeight: 600,\r\n    color: \"#1a237e\",\r\n    marginBottom: theme.spacing(2),\r\n  },\r\n  spinner: {\r\n    width: 40,\r\n    height: 40,\r\n    margin: \"0 auto 16px\",\r\n    border: \"4px solid #e3f2fd\",\r\n    borderTop: \"4px solid #014d88\",\r\n    borderRadius: \"50%\",\r\n    animation: \"$spin 1s linear infinite\",\r\n  },\r\n  \"@keyframes spin\": {\r\n    \"0%\": { transform: \"rotate(0deg)\" },\r\n    \"100%\": { transform: \"rotate(360deg)\" },\r\n  },\r\n  errorAlert: {\r\n    marginTop: theme.spacing(2),\r\n  },\r\n}));\r\n\r\nconst PAGE_SIZE_OPTIONS = [10, 20, 100];\r\n\r\nexport default function Prep(props) {\r\n  const classes = useStyles();\r\n  const [facilities, setFacilities] = useState([]);\r\n  const [facility, setFacility] = useState(\"\");\r\n  const [processing, setProcessing] = useState(false);\r\n  const [status, setStatus] = useState(false); // false = Updated, true = Initial\r\n  const [checked, setChecked] = useState([]);\r\n  const [modal, setModal] = useState(false);\r\n  const [selectedRows, setSelectedRows] = useState([]);\r\n  const [selectPatients, setSelectPatients] = useState([]);\r\n  const [pageSize, setPageSize] = useState(10);\r\n\r\n  const toggle = useCallback(() => setModal((m) => !m), []);\r\n\r\n  useEffect(() => {\r\n    let isMounted = true;\r\n    axios\r\n      .get(`${api.url}account`, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      })\r\n      .then((response) => {\r\n        if (!isMounted) return;\r\n        const { currentOrganisationUnitName, currentOrganisationUnitId } =\r\n          response.data;\r\n        setFacilities([\r\n          {\r\n            facility: currentOrganisationUnitName,\r\n            facilityId: currentOrganisationUnitId,\r\n          },\r\n        ]);\r\n      })\r\n      .catch(() => {\r\n        toast.error(\"Unable to load facilities. Please refresh the page.\");\r\n      });\r\n    return () => {\r\n      isMounted = false;\r\n    };\r\n  }, []);\r\n\r\n  const handleToggle = useCallback(\r\n    (value) => () => {\r\n      setChecked((prev) => {\r\n        const currentIndex = prev.indexOf(value);\r\n        const newChecked = [...prev];\r\n        if (currentIndex === -1) newChecked.push(value);\r\n        else newChecked.splice(currentIndex, 1);\r\n        return newChecked;\r\n      });\r\n    },\r\n    [],\r\n  );\r\n\r\n  const handleRowSelection = useCallback((rows) => {\r\n    setSelectedRows(rows);\r\n    setSelectPatients(uniq(rows.map((row) => row.personUuid).filter(Boolean)));\r\n  }, []);\r\n\r\n  const facilityQueryString = useMemo(() => {\r\n    return checked.map((value) => `facilityIds=${value.facilityId}`).join(\"&\");\r\n  }, [checked]);\r\n\r\n  const generateAction = useCallback(async () => {\r\n    if (!facilityQueryString) return;\r\n\r\n    setProcessing(true);\r\n    setModal(true);\r\n\r\n    const usePatients = selectPatients.length > 0;\r\n\r\n    const endpoint = usePatients\r\n      ? `${api.url}ndr/generate/prep?${facilityQueryString}&isInitial=${status}&patientIds=${selectPatients}`\r\n      : `${api.url}ndr/prep?${facilityQueryString}&isInitial=${status}`;\r\n\r\n    try {\r\n      await axios.get(endpoint, {\r\n        headers: { Authorization: `Bearer ${token}` },\r\n      });\r\n\r\n      window.setTimeout(() => {\r\n        toast.success(\"Generating PrEP XML Successful!\");\r\n        setModal(false);\r\n        setProcessing(false);\r\n        setSelectPatients([]);\r\n        props.setValue(5);\r\n      }, 3000);\r\n    } catch (error) {\r\n      setModal(false);\r\n      setProcessing(false);\r\n\r\n      const errorMessage =\r\n        error?.response?.data?.apierror?.message?.trim() ||\r\n        \"Something went wrong. Please try again.\";\r\n\r\n      toast.error(errorMessage);\r\n    }\r\n  }, [facilityQueryString, selectPatients, status, props]);\r\n\r\n  const fetchPatients = useCallback(\r\n    (query) => {\r\n      const effectiveSize = query.pageSize || pageSize;\r\n      const params = new URLSearchParams({\r\n        search: query.search || \"\",\r\n        page: String(query.page ?? 0),\r\n        size: String(effectiveSize),\r\n      });\r\n\r\n      return axios\r\n        .get(`${baseUrl}ndr/prep/list?${params.toString()}`, {\r\n          headers: { Authorization: `Bearer ${token}` },\r\n        })\r\n        .then((result) => ({\r\n          data: (result.data.content || []).map((row) => ({\r\n            personId: row.uniqueClientId,\r\n            personUuid: row.uuid,\r\n            hospitalNumber: row.hospitalNumber,\r\n          })),\r\n          page: result.data.number ?? query.page ?? 0,\r\n          totalCount: result.data.totalElements ?? 0,\r\n        }))\r\n        .catch(() => {\r\n          toast.error(\"Failed to load patients.\");\r\n          return { data: [], page: 0, totalCount: 0 };\r\n        });\r\n    },\r\n    [pageSize],\r\n  );\r\n\r\n  const columns = useMemo(\r\n    () => [\r\n      { title: \"Patient Id\", field: \"personId\", filtering: false },\r\n      { title: \"Patient Uuid\", field: \"personUuid\", filtering: false },\r\n      { title: \"Hospital No\", field: \"hospitalNumber\", filtering: false },\r\n    ],\r\n    [],\r\n  );\r\n\r\n  const tableOptions = useMemo(\r\n    () => ({\r\n      search: true,\r\n      selection: true,\r\n      headerStyle: {\r\n        backgroundColor: \"#014d88\",\r\n        color: \"#fff\",\r\n        fontWeight: 600,\r\n      },\r\n      rowStyle: (rowData) => ({\r\n        backgroundColor: selectedRows.find(\r\n          (row) => row.tableData?.id === rowData.tableData?.id,\r\n        )\r\n          ? \"#e8f5e9\"\r\n          : \"\",\r\n      }),\r\n      filtering: false,\r\n      exportButton: false,\r\n      searchFieldAlignment: \"left\",\r\n      pageSizeOptions: PAGE_SIZE_OPTIONS,\r\n      pageSize,\r\n      debounceInterval: 400,\r\n      toolbar: true,\r\n    }),\r\n    [pageSize, selectedRows],\r\n  );\r\n\r\n  const handleChangeRowsPerPage = useCallback((newPageSize) => {\r\n    setPageSize(newPageSize);\r\n  }, []);\r\n\r\n  const toolbarComponent = useMemo(\r\n    () => (toolbarProps) => (\r\n      <div>\r\n        <MTableToolbar {...toolbarProps} />\r\n      </div>\r\n    ),\r\n    [],\r\n  );\r\n\r\n  const hasFacilities = facilities.length > 0;\r\n  const canGenerate = checked.length >= 1 && !processing;\r\n\r\n  return (\r\n    <div>\r\n      <ToastContainer autoClose={3000} hideProgressBar />\r\n\r\n      <Card className={classes.card}>\r\n        <CardBody>\r\n          <Alert severity=\"info\">\r\n            <AlertTitle>Generate PrEP XML</AlertTitle>\r\n            Select one or more facilities below, choose the data type, then\r\n            click\r\n            <strong> Generate PrEP XML</strong>. You may optionally select\r\n            specific patients from the table to limit the export.\r\n          </Alert>\r\n\r\n          <div className=\"row mt-4\">\r\n            {/* Data Type */}\r\n            <div className=\"col-md-4\">\r\n              <div className={classes.sectionTitle}>Data Type</div>\r\n              <div className={classes.radioGroup}>\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === false}\r\n                    onChange={() => setStatus(false)}\r\n                  />\r\n                  Updated\r\n                </label>\r\n                <label className={classes.radioLabel}>\r\n                  <input\r\n                    type=\"radio\"\r\n                    name=\"status\"\r\n                    checked={status === true}\r\n                    onChange={() => setStatus(true)}\r\n                  />\r\n                  Initial\r\n                </label>\r\n              </div>\r\n            </div>\r\n\r\n            {/* Facilities */}\r\n            <div className=\"col-md-4\">\r\n              <div className={classes.sectionTitle}>\r\n                <AccountBalanceIcon style={{ fontSize: 16 }} />\r\n                Facilities ({checked.length} selected)\r\n              </div>\r\n              <div className={classes.facilityPanel}>\r\n                {hasFacilities ? (\r\n                  facilities.map((value) => (\r\n                    <div\r\n                      key={value.facilityId}\r\n                      className={classes.facilityItem}\r\n                      onClick={handleToggle(value)}\r\n                      role=\"button\"\r\n                      tabIndex={0}\r\n                      onKeyDown={(e) =>\r\n                        e.key === \"Enter\" && handleToggle(value)()\r\n                      }\r\n                      style={{\r\n                        display: \"flex\",\r\n                        alignItems: \"center\",\r\n                        padding: \"6px 10px\",\r\n                        cursor: \"pointer\",\r\n                      }}\r\n                    >\r\n                      <input\r\n                        type=\"checkbox\"\r\n                        checked={checked.indexOf(value) !== -1}\r\n                        onChange={handleToggle(value)}\r\n                        onClick={(e) => e.stopPropagation()}\r\n                        style={{ marginRight: 10, cursor: \"pointer\" }}\r\n                      />\r\n                      <span style={{ fontSize: \"0.85rem\", color: \"#333\" }}>\r\n                        {value.facility}\r\n                      </span>\r\n                    </div>\r\n                  ))\r\n                ) : (\r\n                  <div className={classes.emptyState}>\r\n                    No facilities available\r\n                  </div>\r\n                )}\r\n              </div>\r\n            </div>\r\n\r\n            {/* Action */}\r\n            <div className=\"col-md-4 d-flex flex-column justify-content-between\">\r\n              <div className={classes.sectionTitle}>Action</div>\r\n              <Button\r\n                variant=\"contained\"\r\n                className={classes.generateBtn}\r\n                disabled={!canGenerate}\r\n                onClick={generateAction}\r\n                startIcon={<GiFiles />}\r\n              >\r\n                {processing ? \"Generating...\" : \"Generate Prep XML\"}\r\n              </Button>\r\n              {selectPatients.length > 0 && (\r\n                <div\r\n                  style={{\r\n                    fontSize: \"0.78rem\",\r\n                    color: \"#5c6bc0\",\r\n                    marginTop: 8,\r\n                  }}\r\n                >\r\n                  {selectPatients.length} patient(s) selected for export\r\n                </div>\r\n              )}\r\n            </div>\r\n          </div>\r\n\r\n          <div className=\"mt-4\">\r\n            <MaterialTable\r\n              icons={tableIcons}\r\n              title=\"Eligible Patients\"\r\n              columns={columns}\r\n              data={fetchPatients}\r\n              options={tableOptions}\r\n              onChangeRowsPerPage={handleChangeRowsPerPage}\r\n              components={{\r\n                Toolbar: toolbarComponent,\r\n              }}\r\n              onSelectionChange={handleRowSelection}\r\n            />\r\n          </div>\r\n        </CardBody>\r\n      </Card>\r\n\r\n      <Modal\r\n        isOpen={modal}\r\n        toggle={toggle}\r\n        backdrop=\"static\"\r\n        centered\r\n        size=\"md\"\r\n      >\r\n        <ModalBody className={classes.modalBody}>\r\n          <div className={classes.spinner} />\r\n          <div className={classes.modalTitle}>Generating PrEP XML Files</div>\r\n          <div style={{ color: \"#666\", fontSize: \"0.85rem\" }}>\r\n            Please wait while we process your request. This may take a few\r\n            moments.\r\n          </div>\r\n        </ModalBody>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n",["114","115"],"C:\\Users\\victor.ajor\\Lamisplus_public\\NDR_Module\\src\\main\\webapp\\jsx\\components\\ndr\\Pmtct.js",[],{"ruleId":"116","severity":1,"message":"117","line":4,"column":41,"nodeType":"118","messageId":"119","endLine":4,"endColumn":47},{"ruleId":"116","severity":1,"message":"120","line":10,"column":8,"nodeType":"118","messageId":"119","endLine":10,"endColumn":14},{"ruleId":"116","severity":1,"message":"121","line":2,"column":10,"nodeType":"118","messageId":"119","endLine":2,"endColumn":13},{"ruleId":"116","severity":1,"message":"122","line":2,"column":15,"nodeType":"118","messageId":"119","endLine":2,"endColumn":18},{"ruleId":"116","severity":1,"message":"123","line":19,"column":8,"nodeType":"118","messageId":"119","endLine":19,"endColumn":14},{"ruleId":"116","severity":1,"message":"124","line":20,"column":8,"nodeType":"118","messageId":"119","endLine":20,"endColumn":14},{"ruleId":"116","severity":1,"message":"125","line":47,"column":19,"nodeType":"118","messageId":"119","endLine":47,"endColumn":29},{"ruleId":"126","severity":1,"message":"127","line":178,"column":6,"nodeType":"128","endLine":178,"endColumn":16,"suggestions":"129"},{"ruleId":"130","severity":1,"message":"131","line":11,"column":10,"nodeType":"132","messageId":"133","endLine":11,"endColumn":24,"fix":"134"},{"ruleId":"116","severity":1,"message":"135","line":318,"column":27,"nodeType":"118","messageId":"119","endLine":318,"endColumn":34},{"ruleId":"130","severity":1,"message":"131","line":11,"column":10,"nodeType":"132","messageId":"133","endLine":11,"endColumn":24,"fix":"136"},{"ruleI